apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-live-browser-fixture
  namespace: astronomer-delivery-system
  labels:
    app.kubernetes.io/managed-by: astronomer-live-browser
spec:
  podSelector:
    matchLabels:
      app: source-controller
  policyTypes:
    - Egress
  egress:
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
        - ipBlock:
            cidr: ::/0
      ports:
        - protocol: TCP
          port: __FIXTURE_PORT__
