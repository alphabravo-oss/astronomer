{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "govulncheck",
          "semanticVersion": "v1.8.0",
          "informationUri": "https://pkg.go.dev/golang.org/x/vuln/cmd/govulncheck",
          "properties": {
            "protocol_version": "v1.0.0",
            "scanner_name": "govulncheck",
            "scanner_version": "v1.8.0",
            "db": "https://vuln.go.dev",
            "db_last_modified": "2026-10-08T22:31:09Z",
            "go_version": "go1.27.2",
            "scan_level": "symbol",
            "scan_mode": "source"
          },
          "rules": [
            {
              "id": "GO-2026-5932",
              "shortDescription": {
                "text": "[GO-2026-5932] The golang.org/x/crypto/openpgp package is unmaintained, unsafe by design, and has known security issues"
              },
              "fullDescription": {
                "text": "The golang.org/x/crypto/openpgp package is unmaintained, unsafe by design, and has known security issues"
              },
              "help": {
                "text": "The golang.org/x/crypto/openpgp package is unsafe by design, has numerous known security issues, is not maintained, and should not be used.\n\nIf you are required to interoperate with OpenPGP systems and need a maintained package, consider github.com/ProtonMail/go-crypto/openpgp which is a maintained fork that aims to be a drop-in replacement for this package."
              },
              "helpUri": "https://pkg.go.dev/vuln/GO-2026-5932",
              "properties": {
                "tags": []
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "GO-2026-5932",
          "level": "note",
          "message": {
            "text": "Your code depends on 1 vulnerable module (golang.org/x/crypto), but doesn't appear to call any of the vulnerable symbols."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "go.mod",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              },
              "message": {
                "text": "Findings for vulnerability GO-2026-5932"
              }
            }
          ]
        }
      ]
    }
  ]
