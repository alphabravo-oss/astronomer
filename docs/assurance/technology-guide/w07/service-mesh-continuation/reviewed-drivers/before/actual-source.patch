+// This tunnel peer issues an opaque Kubernetes token. It does not manufacture
+// a SQL cursor or accept a request carrying a resourceVersion with Continue.
+type meshContinuationPeer struct {
+	cluster  uuid.UUID
+	path     string
+	failure  string
+	requests []string
+}
+
+func (p *meshContinuationPeer) Do(ctx context.Context, cluster, method, target string, _ []byte, _ map[string]string) (*protocol.K8sResponsePayload, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if cluster != p.cluster.String() || method != http.MethodGet {
+		return nil, fmt.Errorf("incorrect scoped tunnel request")
+	}
+	u, err := url.Parse(target)
+	if err != nil {
+		return nil, err
+	}
+	if u.Path != p.path {
+		return &protocol.K8sResponsePayload{StatusCode: http.StatusNotFound}, nil
+	}
+	p.requests = append(p.requests, target)
+	if u.Query().Get("resourceVersion") != "" {
+		return nil, fmt.Errorf("request replaced continuation snapshot")
+	}
+	const token = "opaque snapshot +/?="
+	name, version, next := "first", "fixture-snapshot", token
+	if continuation := u.Query().Get("continue"); continuation != "" {
+		if continuation != token {
+			return nil, fmt.Errorf("opaque continuation changed")
+		}
+		if p.failure == "expired" {
+			return &protocol.K8sResponsePayload{StatusCode: http.StatusGone}, nil
+		}
+		name, next = "second", ""
+		if p.failure == "cycle" {
+			next = token
+		}
+		if p.failure == "snapshot" {
+			version = "changed-snapshot"
+		}
+	}
+	body := map[string]any{
+		"metadata": map[string]any{"resourceVersion": version, "continue": next},
+		"items": []any{map[string]any{
+			"metadata": map[string]any{"name": name, "namespace": name},
+			"spec":     map[string]any{"mtls": map[string]any{"mode": "STRICT"}},
+		}},
+	}
+	raw, err := json.Marshal(body)
+	if err != nil {
+		return nil, err
+	}
+	return &protocol.K8sResponsePayload{StatusCode: http.StatusOK, Body: base64.StdEncoding.EncodeToString(raw)}, nil
+}
+
+func TestServiceMeshInventoryConsumesOpaqueContinuation(t *testing.T) {
+	cluster := uuid.New()
+	h := NewServiceMeshHandler(newFakeServiceMeshQuerier(cluster, "fixture"))
+	def := istioInventoryResources[0]
+	peer := &meshContinuationPeer{cluster: cluster, path: def.Path}
+	h.SetRequester(peer)
+	w := httptest.NewRecorder()
+	h.Inventory(w, smReq(t, http.MethodGet, "/", cluster))
+	if w.Code != http.StatusOK {
+		t.Fatalf("status=%d", w.Code)
+	}
+	var response ServiceMeshInventoryResponse
+	unwrapDataResp(t, w, &response)
+	for _, resource := range response.Resources {
+		if resource.Kind != def.Kind {
+			continue
+		}
+		if resource.Count != 2 || len(resource.Items) != 2 || resource.Items[1].Name != "second" || resource.Notice != "" {
+			t.Fatalf("continuation was lost: count=%d items=%d notice=%q", resource.Count, len(resource.Items), resource.Notice)
+		}
+		if len(peer.requests) != 2 {
+			t.Fatalf("page requests=%d, want 2", len(peer.requests))
+		}
+		return
+	}
+	t.Fatal("target resource absent")
+}
+
+func TestServiceMeshMTLSConsumesOpaqueContinuation(t *testing.T) {
+	cluster := uuid.New()
+	q := newFakeServiceMeshQuerier(cluster, "fixture")
+	q.rows[cluster] = sqlc.ClusterServiceMesh{ClusterID: cluster, DetectedMesh: "istio", PeerAuthenticationCount: 2}
+	h := NewServiceMeshHandler(q)
+	peer := &meshContinuationPeer{cluster: cluster, path: "/apis/security.istio.io/v1beta1/peerauthentications"}
+	h.SetRequester(peer)
+	w := httptest.NewRecorder()
+	h.MTLS(w, smReq(t, http.MethodGet, "/", cluster))
+	if w.Code != http.StatusOK {
+		t.Fatalf("status=%d", w.Code)
+	}
+	var response MTLSBreakdownResponse
+	unwrapDataResp(t, w, &response)
+	seen := map[string]bool{}
+	for _, row := range response.Rows {
+		seen[row.Namespace] = row.Rules == 1 && row.Mode == "STRICT"
+	}
+	if len(response.Rows) != 2 || !seen["first"] || !seen["second"] || response.Notice != "" {
+		t.Fatalf("mTLS breakdown silently truncated: rows=%d notice=%q", len(response.Rows), response.Notice)
+	}
+	if response.TotalCount != 2 {
+		t.Fatal("stored aggregate count changed")
+	}
+}
+
+func TestServiceMeshIncompleteContinuationNeverClaimsComplete(t *testing.T) {
+	for _, failure := range []string{"expired", "cycle", "snapshot"} {
+		t.Run(failure, func(t *testing.T) {
+			cluster := uuid.New()
+			h := NewServiceMeshHandler(newFakeServiceMeshQuerier(cluster, "fixture"))
+			def := istioInventoryResources[0]
+			h.SetRequester(&meshContinuationPeer{cluster: cluster, path: def.Path, failure: failure})
+			w := httptest.NewRecorder()
+			h.Inventory(w, smReq(t, http.MethodGet, "/", cluster))
+			if w.Code != http.StatusOK {
+				t.Fatalf("status=%d", w.Code)
+			}
+			var response ServiceMeshInventoryResponse
+			unwrapDataResp(t, w, &response)
+			for _, resource := range response.Resources {
+				if resource.Kind != def.Kind {
+					continue
+				}
+				if len(resource.Items) != 0 || resource.Count != 0 || !strings.Contains(resource.Notice, "incomplete") {
+					t.Fatalf("partial list advertised as complete: count=%d items=%d notice=%q", resource.Count, len(resource.Items), resource.Notice)
+				}
+				return
+			}
+			t.Fatal("target resource absent")
+		})
+	}
+}
