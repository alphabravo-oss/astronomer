{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.alphabravo.io/schemas/catalog-index-v1.json",
  "title": "Astronomer application catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "repositories", "applications"],
  "properties": {
    "$schema": { "const": "./schemas/catalog-index-v1.schema.json" },
    "apiVersion": { "const": "catalog.astronomer.dev/v1alpha1" },
    "kind": { "const": "ApplicationCatalog" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "minimumReaderVersion", "name", "displayName", "channel"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "minimumReaderVersion": { "const": 1 },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "channel": { "enum": ["development", "stable"] }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["helm", "oci"] },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": { "$ref": "https://astronomer.alphabravo.io/schemas/catalog-entry-v1.json" }
    }
  }
}
