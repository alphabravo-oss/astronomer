{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.alphabravo.io/schemas/catalog-entry-v1.json",
  "title": "Astronomer catalog entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "summary", "category", "supportTier", "artifact", "compatibility", "resources", "storage", "lifecycle"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "enum": ["monitoring", "logging", "security", "networking", "storage", "database", "other"] },
    "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "home": { "type": "string", "format": "uri", "pattern": "^https://" },
    "documentation": { "type": "string", "format": "uri", "pattern": "^https://" },
    "icon": { "type": "string", "format": "uri", "pattern": "^https://" },
    "ui": { "$ref": "https://astronomer.alphabravo.io/schemas/presentation-v1.json" },
    "supportTier": { "enum": ["astronomer", "upstream", "experimental"] },
    "defaultEnabled": { "type": "boolean" },
    "privileged": { "type": "boolean" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "chart", "version"],
      "properties": {
        "type": { "const": "helm" },
        "repository": { "type": "string", "minLength": 1 },
        "chart": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetes"],
      "properties": {
        "kubernetes": { "type": "string", "minLength": 1 },
        "flux": { "type": "string", "minLength": 1 },
        "requiredAPIs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "architectures": { "type": "array", "items": { "enum": ["amd64", "arm64"] }, "uniqueItems": true }
      }
    },
    "resources": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["small", "medium", "large", "variable"] },
        "notes": { "type": "string" },
        "estimates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$" },
            "ephemeralStorage": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$" },
            "replicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "recommended": { "type": "string" },
        "thinProvisioning": { "type": "boolean" },
        "hostStorage": { "type": "boolean" },
        "externalObjectStorage": { "type": "boolean" },
        "managedClustersRequireStorage": { "type": "boolean" },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "size", "retention"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "size": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$" },
              "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] },
              "retention": { "enum": ["delete", "retain", "prompt"] }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "upgrade", "rollback", "uninstall"],
      "properties": {
        "install": { "type": "boolean" },
        "upgrade": { "type": "boolean" },
        "rollback": { "type": "boolean" },
        "uninstall": { "type": "boolean" }
      }
    },
    "versionMetadata": { "$ref": "https://astronomer.alphabravo.io/schemas/catalog-entry-version-v1.json" },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "ownership", "removalPolicy"],
            "properties": {
              "slug": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "ownership": { "enum": ["exclusive", "shared", "external"] },
              "removalPolicy": { "enum": ["delete", "retain", "block-while-used"] }
            }
          }
        ]
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "severity"],
        "properties": {
          "type": { "enum": ["api", "crd", "storage-class", "csi", "gateway", "ingress", "operator", "application", "external"] },
          "name": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocking", "approval-required", "advisory"] },
          "constraint": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "reason"],
        "properties": {
          "type": { "enum": ["application", "api", "crd", "resource"] },
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "deprecated": { "type": "boolean", "default": false },
    "replacement": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "revoked": { "type": "boolean", "default": false },
    "postInstallNotes": { "type": "string" },
    "dashboardLinks": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "pattern": "^https://" },
      "uniqueItems": true
    }
  }
}
