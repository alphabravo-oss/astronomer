{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unsigned source-bound technology guide verification records",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "workPackage": {
        "type": "string",
        "pattern": "^W[0-9]{2}$"
      },
      "caseId": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "applicationCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "catalogCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "candidateSourceTreeDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "manifestDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "applicationCommit",
          "catalogCommit",
          "candidateSourceTreeDigest"
        ]
      },
      "environment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "source-static",
              "candidate-qualification",
              "cluster-qualification"
            ]
          },
          "kubernetesVersion": {
            "type": "string",
            "minLength": 1
          },
          "cnpgVersion": {
            "type": "string",
            "minLength": 1
          },
          "postgresVersion": {
            "type": "string",
            "minLength": 1
          },
          "networkProfile": {
            "type": "string",
            "minLength": 1
          },
          "goVersion": {
            "type": "string",
            "minLength": 1
          },
          "nodeVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "networkProfile",
          "goVersion",
          "nodeVersion"
        ]
      },
      "execution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expectedCases": {
            "type": "integer",
            "minimum": 0
          },
          "executedCases": {
            "type": "integer",
            "minimum": 0
          },
          "unexpectedSkips": {
            "type": "integer",
            "minimum": 0
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "startedAt",
          "finishedAt",
          "command",
          "expectedCases",
          "executedCases",
          "unexpectedSkips",
          "exitCode"
        ]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-run",
              "deferred",
              "not-applicable"
            ]
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "digest"
              ]
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "assertions",
          "artifacts",
          "limitations"
        ]
      }
    },
    "required": [
      "schemaVersion",
      "workPackage",
      "caseId",
      "source",
      "environment",
      "execution",
      "result"
    ]
  }
}
