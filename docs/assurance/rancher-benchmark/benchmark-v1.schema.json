{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.io/schemas/rancher-ux-benchmark-v1.json",
  "title": "Astronomer and Rancher adopted-cluster UX benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "subjects", "policy", "qualification", "task_results"],
  "properties": {
    "schema_version": {"const": "rancher-ux-benchmark/v1"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "started_at", "finished_at", "environment", "browser"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "environment": {"type": "string", "minLength": 1, "maxLength": 256},
        "browser": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "subjects": {
      "type": "object", "additionalProperties": false,
      "required": ["astronomer", "rancher"],
      "properties": {
        "astronomer": {"$ref": "#/$defs/subject"},
        "rancher": {
          "allOf": [
            {"$ref": "#/$defs/subject"},
            {"properties": {"source_commit": {"const": "e870de073d56eec568516fae4bc5f76c5d409909"}, "ui_version": {"const": "v2.15.0-alpha1"}}}
          ]
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["repetitions_per_cache_mode", "max_task_regression_ratio", "task_set_active_time_ratio"],
      "properties": {
        "repetitions_per_cache_mode": {"const": 3},
        "max_task_regression_ratio": {"const": 1.2},
        "task_set_active_time_ratio": {"const": 1}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["automated", "human_clarity", "overall"],
      "properties": {
        "automated": {"$ref": "#/$defs/qualificationStatus"},
        "human_clarity": {"$ref": "#/$defs/qualificationStatus"},
        "overall": {"$ref": "#/$defs/qualificationStatus"}
      }
    },
    "task_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskResult"}},
    "human_evaluation": {"$ref": "#/$defs/humanEvaluation"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "image_digest", "ui_version"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "image_digest": {"$ref": "#/$defs/digest"},
        "ui_version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "qualificationStatus": {"type": "string", "enum": ["pass", "fail", "pending"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["active_ms", "wall_ms", "pointer_activations", "keyboard_activations", "route_transitions", "error_count", "recovery_actions", "duplicate_effects"],
      "properties": {
        "active_ms": {"type": "integer", "minimum": 0}, "wall_ms": {"type": "integer", "minimum": 0},
        "pointer_activations": {"type": "integer", "minimum": 0}, "keyboard_activations": {"type": "integer", "minimum": 0},
        "route_transitions": {"type": "integer", "minimum": 0}, "error_count": {"type": "integer", "minimum": 0},
        "recovery_actions": {"type": "integer", "minimum": 0}, "duplicate_effects": {"const": 0}
      }
    },
    "taskResult": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "product", "cache_mode", "attempt", "outcome", "metrics", "evidence"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "product": {"enum": ["astronomer", "rancher"]}, "cache_mode": {"enum": ["cold", "warm"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "outcome": {"enum": ["pass", "fail"]},
        "metrics": {"$ref": "#/$defs/metrics"},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["trace_uri", "trace_sha256", "screenshot_uri", "screenshot_sha256", "success_probe"],
          "properties": {
            "trace_uri": {"type": "string", "minLength": 1, "maxLength": 512}, "trace_sha256": {"$ref": "#/$defs/digest"},
            "screenshot_uri": {"type": "string", "minLength": 1, "maxLength": 512}, "screenshot_sha256": {"$ref": "#/$defs/digest"},
            "success_probe": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "humanResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_id_sha256", "task_id", "product", "order", "unassisted_completion", "first_click_correct", "help_requests", "recovery_success", "ratings"],
      "properties": {
        "participant_id_sha256": {"$ref": "#/$defs/digest"}, "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "product": {"enum": ["astronomer", "rancher"]}, "order": {"enum": [1, 2]},
        "unassisted_completion": {"type": "boolean"}, "first_click_correct": {"type": "boolean"},
        "help_requests": {"type": "integer", "minimum": 0}, "recovery_success": {"type": "boolean"},
        "ratings": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 5}}
      }
    },
    "humanEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["study_version", "participant_count", "counterbalanced", "results_uri", "results_sha256", "source_evidence_sha256", "source_bundle_sha256", "source_run_id", "source_workflow", "source_commit", "source_ref", "source_conclusion", "reviewer", "responses"],
      "properties": {
        "study_version": {"const": "counterbalanced-crossover/v1"}, "participant_count": {"type": "integer", "minimum": 8},
        "counterbalanced": {"const": true}, "results_uri": {"type": "string", "minLength": 1, "maxLength": 512},
        "results_sha256": {"$ref": "#/$defs/digest"}, "source_evidence_sha256": {"$ref": "#/$defs/digest"},
        "source_bundle_sha256": {"$ref": "#/$defs/digest"}, "source_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "source_workflow": {"const": ".github/workflows/rancher-human-study.yaml"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_ref": {"type": "string", "pattern": "^refs/tags/v1\\.[0-9]+\\.[0-9]+$"}, "source_conclusion": {"const": "success"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
        "responses": {"type": "array", "minItems": 80, "items": {"$ref": "#/$defs/humanResponse"}}
      }
    }
  }
}
