    },
    {
      "classification": "tombstone_then_retention",
      "owner": "cluster-decommission",
      "mechanism": "soft delete, durable decommission phases, audit identity archival, then bounded purge",
      "audit": "mandatory mutation audit plus archived cluster identity before final purge",
      "tables": [
        "clusters"
      ]
    },
    {
      "classification": "explicit_audited_purge",
      "owner": "domain-service",
      "mechanism": "explicit authorized mutation; state and mandatory audit intent commit in one transaction",
