{
  "schema_version": 1,
  "policies": [
    {
      "classification": "retention",
      "owner": "lifecycle-maintenance",
      "mechanism": "bounded scheduled retention or expiry cleanup",
      "audit": "retention execution is observable; individual ephemeral rows do not require a mutation audit",
