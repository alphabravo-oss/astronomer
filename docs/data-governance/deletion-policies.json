    {
      "classification": "derived_or_reconciled",
      "owner": "parent-resource-reconciler",
      "mechanism": "parent lifecycle, reconciliation, or replace-in-full cleanup",
      "audit": "the parent mutation or reconciliation run is the authoritative audit event",
      "tables": [
        "agent_lifecycle_operations",
        "alert_rule_channels",
        "catalog_blessed_charts",
