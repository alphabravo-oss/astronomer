{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.charlie.local/capability-v1.schema.json",
  "title": "CapabilityDisclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "description", "effect", "risk", "auto_eligible",
    "destructive", "irreversible", "target_constraints", "timeout_ms",
    "idempotency", "argument_schema"
  ],
  "properties": {
    "schema": {"type": "string", "const": "charlie.capability/v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 512},
    "effect": {"type": "string", "enum": ["read", "write"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "auto_eligible": {"type": "boolean"},
    "destructive": {"type": "boolean", "const": false},
    "irreversible": {"type": "boolean", "const": false},
    "target_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_kinds", "max_targets", "wildcards_allowed", "urls_allowed"],
      "properties": {
        "allowed_kinds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
        },
        "max_targets": {"type": "integer", "minimum": 1, "maximum": 25},
        "wildcards_allowed": {"type": "boolean", "const": false},
        "urls_allowed": {"type": "boolean", "const": false}
      }
    },
    "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000},
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "key_source", "ambiguous_replay"],
      "properties": {
        "required": {"type": "boolean"},
        "key_source": {"type": "string", "enum": ["none", "action_id"]},
        "ambiguous_replay": {"type": "string", "enum": ["not_applicable", "reconcile_postcondition"]}
      }
    },
    "preconditions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "expected_impact": {"type": "string", "minLength": 1, "maxLength": 512},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "timeout_ms"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000}
      }
    },
    "reversible": {"type": "boolean"},
    "rollback_description": {"type": "string", "minLength": 1, "maxLength": 512},
    "argument_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties", "properties"],
      "properties": {
        "type": {"type": "string", "const": "object"},
        "additionalProperties": {"type": "boolean", "const": false},
        "maxProperties": {"type": "integer", "minimum": 1, "maximum": 32},
        "required": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"}
        },
        "properties": {
          "type": "object", "maxProperties": 32,
          "additionalProperties": {"$ref": "#/$defs/argumentProperty"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"effect": {"const": "write"}}, "required": ["effect"]},
      "then": {
        "required": ["preconditions", "expected_impact", "verification", "reversible"],
        "properties": {
          "idempotency": {
            "properties": {
              "required": {"const": true},
              "key_source": {"const": "action_id"},
              "ambiguous_replay": {"const": "reconcile_postcondition"}
            }
          },
          "argument_schema": {
            "properties": {
              "required": {"contains": {"const": "resource_id"}},
              "properties": {
                "required": ["resource_id"],
                "properties": {
                  "resource_id": {
                    "required": ["type"],
                    "properties": {"type": {"const": "string"}}
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "auto_eligible": {"const": false},
          "idempotency": {
            "properties": {
              "required": {"const": false},
              "key_source": {"const": "none"},
              "ambiguous_replay": {"const": "not_applicable"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"reversible": {"const": true}}, "required": ["reversible"]},
      "then": {"required": ["rollback_description"]}
    }
  ],
  "$defs": {
    "argumentProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["string", "integer", "number", "boolean"]},
        "description": {"type": "string", "maxLength": 256},
        "enum": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true},
        "minLength": {"type": "integer", "minimum": 0, "maximum": 4096},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 4096},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    }
  }
}
