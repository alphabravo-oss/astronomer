          "required_assertions": ["state_applied", "process_absent", "listener_absent", "timer_absent", "dns_packets_zero", "tcp_packets_zero", "udp_packets_zero", "runtime_counters_unchanged", "downstream_counters_unchanged"]
        },
        {
          "id": "unactivated",
          "timeout_ms": 180000,
          "required_assertions": ["state_applied", "process_absent", "listener_absent", "timer_absent", "dns_packets_zero", "tcp_packets_zero", "udp_packets_zero", "runtime_counters_unchanged", "downstream_counters_unchanged"]
        },
        {
          "id": "central_disabled",
          "timeout_ms": 180000,
          "required_assertions": ["state_applied", "control_protocol_only", "runtime_counters_unchanged", "downstream_counters_unchanged"]
        },
        {
          "id": "emergency_disabled",
          "timeout_ms": 180000,
          "required_assertions": ["state_applied", "control_protocol_only", "runtime_counters_unchanged", "downstream_counters_unchanged"]
