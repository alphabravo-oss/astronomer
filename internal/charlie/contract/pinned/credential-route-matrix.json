  "artifact_registry": {
    "purpose": "artifact_pull",
    "allowed": [
      "manifest.get:declared_repository_and_digest",
      "blob.get:descriptor_reachable_from_authorized_manifest"
    ],
    "transitive_blob_rule": {
      "manifest_authority": "repository_and_digest_declared_in_onboarding_package",
      "config_blob": "allowed_only_if_descriptor_digest_is_reachable_from_authorized_manifest",
      "layer_blob": "allowed_only_if_descriptor_digest_is_reachable_from_authorized_manifest"
    },
    "denied": [
      "catalog.list",
      "tag.list",
      "manifest.push",
      "manifest.delete",
      "blob.push",
      "blob.delete",
      "cross_repository_mount",
      "unrelated_blob.get",
      "unrelated_manifest.get"
    ]
  },
  "notes": {
    "agent_enrollment": "Accepted only by the single rotating enrollment exchange and grants no other central operation.",
    "artifact_pull": "Grants no central or bridge operation and cannot be exchanged for a custom scope.",
    "no_scope_elevation": true
  }
