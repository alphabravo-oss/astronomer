{
  "version": 1,
  "coverage_classes": [
    "success",
    "denial",
    "failure",
    "replay",
    "redaction"
  ],
  "governance": {
    "owner": "astronomer",
    "system_of_record": "audit_log",
    "retention_class": "platform_setting.audit.retention_days",
    "correlation_rule": "bounded_opaque_or_sha256"
  },
  "denial_codes": [
    "feature_disabled",
    "connection_inactive",
    "emergency_disabled",
    "mode_disabled",
    "destructive_capability",
    "disclosure_changed",
    "authorization_denied",
    "audit_unavailable",
    "read_only_write",
    "approval_required",
    "approval_invalid",
    "not_auto_eligible",
    "not_allowlisted",
    "scope_denied",
    "budget_exhausted",
    "cooldown_active",
    "circuit_open",
    "precondition_failed",
    "idempotency_required",
    "verification_required",
    "stale_fencing_epoch",
    "ambiguous_prior_attempt",
    "maintenance_window"
  ],
  "fields": {
    "outcome_code": {
      "kind": "code"
    },
    "visibility": {
      "kind": "enum",
      "values": [
        "private",
        "incident"
      ]
    },
    "resource_count": {
      "kind": "count"
    },
    "approval_digest": {
      "kind": "digest"
    },
    "action_digest": {
      "kind": "digest"
    },
    "manifest_digest": {
      "kind": "digest"
    },
    "capability": {
      "kind": "code"
    },
    "decision": {
      "kind": "enum",
      "values": [
        "approve",
        "reject"
      ]
    },
    "phase": {
      "kind": "enum",
      "values": [
        "proposed",
        "denied",
        "fenced",
        "replayed",
        "deferred",
        "approved",
        "dispatched",
        "failed",
        "succeeded"
      ]
    },
    "argument_digest": {
      "kind": "digest"
    },
    "authorization_digest": {
      "kind": "digest"
    },
    "capability_digest": {
      "kind": "digest"
    },
    "effect": {
      "kind": "enum",
      "values": [
        "read",
        "write"
      ]
    },
    "state": {
      "kind": "code",
      "allow_empty": true
    },
    "denial_code": {
      "kind": "enum",
      "values": [
        "feature_disabled",
        "connection_inactive",
        "emergency_disabled",
        "mode_disabled",
        "destructive_capability",
        "disclosure_changed",
        "authorization_denied",
        "audit_unavailable",
        "read_only_write",
        "approval_required",
        "approval_invalid",
        "not_auto_eligible",
        "not_allowlisted",
        "scope_denied",
        "budget_exhausted",
        "cooldown_active",
        "circuit_open",
        "precondition_failed",
        "idempotency_required",
        "verification_required",
        "stale_fencing_epoch",
        "ambiguous_prior_attempt",
        "maintenance_window"
      ],
      "allow_empty": true
    },
    "result_digest": {
      "kind": "digest",
      "allow_empty": true
    },
    "mode_revision": {
      "kind": "count"
    },
    "policy_revision": {
      "kind": "count"
    },
    "fencing_epoch": {
      "kind": "count"
    },
    "outcome": {
      "kind": "enum",
      "values": [
        "succeeded",
        "failed",
        "ambiguous"
      ]
    },
    "attempt": {
      "kind": "count"
    },
    "method": {
      "kind": "enum",
      "values": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "status_code": {
      "kind": "count"
    },
    "duration_ms": {
      "kind": "count"
    },
    "mode": {
      "kind": "enum",
      "values": [
        "disabled",
        "read_only",
        "approval",
        "auto"
      ]
    },
    "mode_ceiling": {
      "kind": "enum",
      "values": [
        "read_only",
        "approval",
        "auto"
      ]
    },
    "revision": {
      "kind": "count"
    },
    "enabled": {
      "kind": "bool"
    },
    "suppressed": {
      "kind": "bool"
    },
    "minimum_severity": {
      "kind": "enum",
      "values": ["info", "low", "medium", "warning", "high", "critical"]
    },
    "dedupe_window_seconds": {
      "kind": "count"
    },
    "escalation_after_seconds": {
      "kind": "count"
    },
    "quiet_hours_enabled": {
      "kind": "bool"
    },
    "channel_count": {
      "kind": "count"
    },
    "delivery_count": {
      "kind": "count"
    },
    "dedupe_valid": {
      "kind": "bool"
    },
    "scenario": {
      "kind": "enum",
      "values": ["mixed_catalog", "malformed_catalog"]
    },
    "accepted_count": {
      "kind": "count"
    },
    "rejected_count": {
      "kind": "count"
    },
    "candidate_enabled": {
      "kind": "bool"
    },
    "catalog_bound": {
      "kind": "bool"
    },
    "overall": {
      "kind": "code"
    },
    "profile": {
      "kind": "enum",
      "values": ["disabled", "product_namespace", "cluster_diagnostics"]
    },
    "pod_logs": {
      "kind": "bool"
    }
  },
