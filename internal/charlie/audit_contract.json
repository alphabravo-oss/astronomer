        "outcome_code",
        "method",
        "status_code",
        "duration_ms"
      ],
      "coverage": [
        "success",
        "denial",
        "failure",
        "redaction"
      ],
      "not_applicable": [
        "replay"
      ],
      "correlation": "request_context"
