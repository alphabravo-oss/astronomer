+// Nil dependencies deliberately panic if validation touches storage/execution.
+func TestDexOperationRejectsInvalidPayloadBeforeStorage(t *testing.T) {
+	t.Parallel()
+	id := uuid.NewString()
+	for _, payload := range []string{
+		`null`, `{}`, `[]`, `{"operation_id":null}`, `{"operation_id":"bad"}`,
+		`{"operation_id":"00000000-0000-0000-0000-000000000000"}`,
+		`{"operation_id":"` + id + `","operation_id":"` + id + `"}`,
+		`{"operation_id":"` + id + `","unexpected":true}`,
+		`{"operation_id":"` + id + `"} {}`,
+		`{"operation_id":"urn:uuid:` + id + `"}`,
+		strings.Repeat(" ", 1025) + `{"operation_id":"` + id + `"}`,
+	} {
+		t.Run(fmt.Sprintf("case-%d", len(payload)), func(t *testing.T) {
+			t.Parallel()
+			err := (DexOperationRuntime{}).Handle(t.Context(), asynq.NewTask(DexOperationType, []byte(payload)))
+			if !errors.Is(err, asynq.SkipRetry) {
+				t.Fatalf("invalid task retried: %v", err)
+			}
+		})
+	}
+	if err := (DexOperationRuntime{}).Handle(t.Context(), nil); !errors.Is(err, asynq.SkipRetry) {
+		t.Fatal(err)
+	}
+}
