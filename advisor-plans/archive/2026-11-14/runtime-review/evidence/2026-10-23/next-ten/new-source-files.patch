+		return nil, err
+	}
+	return items, nil
+}
diff --git a/internal/drcrypto/keybundle_catalog_test.go b/internal/drcrypto/keybundle_catalog_test.go
new file mode 100644
index 0000000000..0c1852538a
--- /dev/null
+++ b/internal/drcrypto/keybundle_catalog_test.go
@@ -0,0 +1,226 @@
+package drcrypto
+
+import (
+	"archive/tar"
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestKeyBundleCatalogTrustRoundTrip(t *testing.T) {
+	t.Parallel()
+	for _, directories := range [][]string{{"catalog-ca"}, {"catalog-signature-trust"}, {"catalog-ca", "catalog-signature-trust"}} {
+		t.Run(fmt.Sprint(directories), func(t *testing.T) {
+			t.Parallel()
+			f := newFixture(t)
+			source := keySource(t, f)
+			for _, dir := range directories {
+				if err := os.Mkdir(filepath.Join(source, dir), 0700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(source, dir, ".trust.pem"), []byte("synthetic trust"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			archive := filepath.Join(f.root, "keys.tar")
+			if err := CreateKeyBundle(source, archive); err != nil {
+				t.Fatal(err)
+			}
+			destination := filepath.Join(f.root, "restored")
+			if err := ExtractKeyBundle(archive, destination); err != nil {
+				t.Fatal(err)
+			}
+			assertRestoredCatalogTrust(t, destination, directories)
+		})
+	}
+}
+
+func assertRestoredCatalogTrust(t *testing.T, destination string, directories []string) {
+	t.Helper()
+	for _, dir := range directories {
+		path := filepath.Join(destination, dir, ".trust.pem")
+		content, err := os.ReadFile(path)
+		if err != nil || string(content) != "synthetic trust" {
+			t.Fatalf("trust file was not restored: %v", err)
+		}
+		for _, entry := range []struct {
+			path string
+			mode os.FileMode
+		}{{destination, 0700}, {filepath.Dir(path), 0700}, {path, 0600}} {
+			info, err := os.Stat(entry.path)
+			if err != nil || info.Mode().Perm() != entry.mode {
+				t.Fatalf("wrong private permissions for %s: %v", entry.path, err)
+			}
+		}
+	}
+}
+
+func TestKeyBundleCatalogTrustLongKeyIsDeterministic(t *testing.T) {
+	t.Parallel()
+	f := newFixture(t)
+	source := keySource(t, f)
+	directory := filepath.Join(source, "catalog-signature-trust")
+	if err := os.Mkdir(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	name := strings.Repeat("k", 249) + ".pem"
+	if err := os.WriteFile(filepath.Join(directory, name), []byte("synthetic trust"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	first, second := filepath.Join(f.root, "first.tar"), filepath.Join(f.root, "second.tar")
+	for _, path := range []string{first, second} {
+		if err := CreateKeyBundle(source, path); err != nil {
+			t.Fatal(err)
+		}
+	}
+	a, err := os.ReadFile(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(second)
+	if err != nil || !bytes.Equal(a, b) {
+		t.Fatalf("long-key archive is not deterministic: %v", err)
+	}
+	destination := filepath.Join(f.root, "restored")
+	if err := ExtractKeyBundle(first, destination); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(filepath.Join(destination, "catalog-signature-trust", name))
+	if err != nil || string(content) != "synthetic trust" {
+		t.Fatalf("long Secret key did not round trip: %v", err)
+	}
+}
+
+func TestKeyBundleCatalogTrustRejectsUnsafeArchives(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name    string
+		members []tar.Header
+	}{
+		{"traversal", []tar.Header{{Name: "catalog-ca/../escape", Typeflag: tar.TypeReg, Size: 1}}},
+		{"absolute", []tar.Header{{Name: "/catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: 1}}},
+		{"unknown directory", []tar.Header{{Name: "other/ca.pem", Typeflag: tar.TypeReg, Size: 1}}},
+		{"nested directory", []tar.Header{{Name: "catalog-ca/nested/ca.pem", Typeflag: tar.TypeReg, Size: 1}}},
+		{"symlink", []tar.Header{{Name: "catalog-ca/ca.pem", Typeflag: tar.TypeSymlink, Linkname: "/tmp/escape"}}},
+		{"hardlink", []tar.Header{{Name: "catalog-ca/ca.pem", Typeflag: tar.TypeLink, Linkname: "SECRET_KEY"}}},
+		{"duplicate", []tar.Header{{Name: "catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: 1}, {Name: "catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: 1}}},
+		{"file before directory", []tar.Header{{Name: "catalog-ca", Typeflag: tar.TypeReg, Size: 1}, {Name: "catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: 1}}},
+		{"directory before file", []tar.Header{{Name: "catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: 1}, {Name: "catalog-ca", Typeflag: tar.TypeReg, Size: 1}}},
+		{"oversized", []tar.Header{{Name: "catalog-ca/ca.pem", Typeflag: tar.TypeReg, Size: (1 << 20) + 1}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			f := newFixture(t)
+			members := append([]tar.Header{{Name: "SECRET_KEY", Typeflag: tar.TypeReg, Size: 1}, {Name: "ASTRONOMER_ENCRYPTION_KEY", Typeflag: tar.TypeReg, Size: 1}}, tc.members...)
+			archive := f.write(t, "bad.tar", testKeyArchive(t, members))
+			destination := filepath.Join(f.root, "restore")
+			if err := ExtractKeyBundle(archive, destination); err == nil {
+				t.Fatal("unsafe archive accepted")
+			}
+			if _, err := os.Stat(destination); !os.IsNotExist(err) {
+				t.Fatal("rejected archive created destination")
+			}
+		})
+	}
+}
+
+func TestKeyBundleCatalogTrustRejectsUnsafeSources(t *testing.T) {
+	t.Parallel()
+	for _, kind := range []string{"empty", "symlink", "nested", "unknown", "empty file"} {
+		t.Run(kind, func(t *testing.T) {
+			t.Parallel()
+			f := newFixture(t)
+			source := keySource(t, f)
+			dir := filepath.Join(source, "catalog-ca")
+			if kind == "unknown" {
+				dir = filepath.Join(source, "unknown")
+			}
+			if err := os.Mkdir(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			var err error
+			switch kind {
+			case "symlink":
+				err = os.Symlink(filepath.Join(source, "SECRET_KEY"), filepath.Join(dir, "ca.pem"))
+			case "nested":
+				err = os.Mkdir(filepath.Join(dir, "nested"), 0700)
+			case "empty file":
+				err = os.WriteFile(filepath.Join(dir, "ca.pem"), nil, 0600)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			output := filepath.Join(f.root, "keys.tar")
+			if err := CreateKeyBundle(source, output); err == nil {
+				t.Fatal("unsafe source accepted")
+			}
+			if _, err := os.Stat(output); !os.IsNotExist(err) {
+				t.Fatal("rejected source published archive")
+			}
+		})
+	}
+}
+
+func TestKeyBundleCatalogTrustLimits(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name        string
+		count, size int
+	}{
+		{"file count", maxKeyBundleFiles, 1},
+		{"total bytes", 17, maxKeyFileBytes},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			f := newFixture(t)
+			source := keySource(t, f)
+			dir := filepath.Join(source, "catalog-ca")
+			if err := os.Mkdir(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			members := []tar.Header{{Name: "SECRET_KEY", Typeflag: tar.TypeReg, Size: 3}, {Name: "ASTRONOMER_ENCRYPTION_KEY", Typeflag: tar.TypeReg, Size: 3}}
+			content := bytes.Repeat([]byte("x"), tc.size)
+			for i := 0; i < tc.count; i++ {
+				name := fmt.Sprintf("catalog-ca/key-%04d.pem", i)
+				if err := os.WriteFile(filepath.Join(source, name), content, 0600); err != nil {
+					t.Fatal(err)
+				}
+				members = append(members, tar.Header{Name: name, Typeflag: tar.TypeReg, Size: int64(tc.size)})
+			}
+			if err := CreateKeyBundle(source, filepath.Join(f.root, "created.tar")); err == nil {
+				t.Fatal("creator accepted excessive bundle")
+			}
+			archive := f.write(t, "excessive.tar", testKeyArchive(t, members))
+			destination := filepath.Join(f.root, "restored")
+			if err := ExtractKeyBundle(archive, destination); err == nil {
+				t.Fatal("extractor accepted excessive bundle")
+			}
+			if _, err := os.Stat(destination); !os.IsNotExist(err) {
+				t.Fatal("rejected archive created destination")
+			}
+		})
+	}
+}
+
+func testKeyArchive(t *testing.T, members []tar.Header) []byte {
+	t.Helper()
+	var buffer bytes.Buffer
+	writer := tar.NewWriter(&buffer)
+	for _, member := range members {
+		if err := writer.WriteHeader(&member); err != nil {
+			t.Fatal(err)
+		}
+		if member.Size > 0 {
+			if _, err := writer.Write(make([]byte, member.Size)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buffer.Bytes()
+}
diff --git a/internal/drcrypto/restore_integration_test.go b/internal/drcrypto/restore_integration_test.go
new file mode 100644
index 0000000000..9eab42bef1
--- /dev/null
+++ b/internal/drcrypto/restore_integration_test.go
@@ -0,0 +1,213 @@
+//go:build integration
+
+package drcrypto
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"filippo.io/age"
+	_ "github.com/jackc/pgx/v5/stdlib"
+	"github.com/testcontainers/testcontainers-go/modules/postgres"
+
+	"github.com/alphabravocompany/astronomer-go/internal/db/migrations"
+	columncrypto "github.com/alphabravocompany/astronomer-go/pkg/crypto"
+)
+
+// This is a disposable PostgreSQL rehearsal of the runbook gates, not a
+// claim that an operator-controlled writer restart is automatically fenced.
+func TestDisposableDatabaseRestoreAndRequiredKeyGates(t *testing.T) {
+	t.Parallel()
+	ctx := t.Context()
+	c, err := postgres.Run(ctx, "postgres:17.11-alpine", postgres.WithDatabase("source"), postgres.WithUsername("restore_test"), postgres.WithPassword("disposable-test-only"), postgres.BasicWaitStrategies())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := c.Terminate(context.Background()); err != nil {
+			t.Error(err)
+		}
+	})
+	dsn, err := c.ConnectionString(ctx, "sslmode=disable")
+	if err != nil {
+		t.Fatal(err)
+	}
+	db, err := sql.Open("pgx", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	if _, err := migrations.Up(ctx, db, slog.New(slog.NewTextHandler(io.Discard, nil))); err != nil {
+		t.Fatal(err)
+	}
+	identity := createRestoreProof(t, ctx, db)
+	run := restoreContainerCommand(t, c)
+	if run("pg_dump", "-U", "restore_test", "-d", "source", "-Fc", "--no-owner", "--no-acl", "-f", "/tmp/restore-test.dump") != 0 {
+		t.Fatal("dump failed")
+	}
+	reader, err := c.CopyFileFromContainer(ctx, "/tmp/restore-test.dump")
+	if err != nil {
+		t.Fatal(err)
+	}
+	dump, err := io.ReadAll(reader)
+	_ = reader.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := newFixture(t)
+	recovered := authenticateRestoreDump(t, f, dump)
+	if err := c.CopyToContainer(ctx, recovered, "/tmp/authenticated.dump", 0600); err != nil {
+		t.Fatal(err)
+	}
+	if run("createdb", "-U", "restore_test", "restored") != 0 {
+		t.Fatal("create failed")
+	}
+	if run("pg_restore", "-U", "restore_test", "-d", "restored", "--single-transaction", "--exit-on-error", "--no-owner", "--no-acl", "/tmp/authenticated.dump") != 0 {
+		t.Fatal("valid restore failed")
+	}
+	restoredDB, err := sql.Open("pgx", strings.Replace(dsn, "/source?", "/restored?", 1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = restoredDB.Close() })
+	var version int64
+	if err := restoredDB.QueryRowContext(ctx, `WITH latest AS (SELECT DISTINCT ON(version_id) version_id,is_applied FROM public.goose_db_version ORDER BY version_id,id DESC) SELECT COALESCE(MAX(version_id),0) FROM latest WHERE is_applied`).Scan(&version); err != nil {
+		t.Fatal(err)
+	}
+	if version != migrations.Latest() {
+		t.Fatalf("restored schema %d != %d", version, migrations.Latest())
+	}
+	restoreKeyProof(t, ctx, f, identity, restoredDB)
+	// Compare the restored Goose observation with an intentionally wrong
+	// manifest version using the same query; this must not authorize resume.
+	var matches bool
+	if err := restoredDB.QueryRowContext(ctx, `WITH latest AS (SELECT DISTINCT ON(version_id) version_id,is_applied FROM public.goose_db_version ORDER BY version_id,id DESC) SELECT COALESCE(MAX(version_id),0) = $1 FROM latest WHERE is_applied`, version+1).Scan(&matches); err != nil || matches {
+		t.Fatalf("schema mismatch gate: matches=%v err=%v", matches, err)
+	}
+	// A second restore into the populated target must fail and roll back, not
+	// be treated as success because some objects/data already exist.
+	if run("pg_restore", "-U", "restore_test", "-d", "restored", "--single-transaction", "--exit-on-error", "--no-owner", "--no-acl", "/tmp/authenticated.dump") == 0 {
+		t.Fatal("restore SQL error ignored")
+	}
+	t.Logf("PASS: PostgreSQL 17.11, Goose %d, authenticated dump/keys, optional trust, encrypted column; missing-key/schema-mismatch/restore-error rejected. No management database or writer touched.", version)
+}
+
+func createRestoreProof(t *testing.T, ctx context.Context, db *sql.DB) *age.X25519Identity {
+	t.Helper()
+	identity, err := age.GenerateX25519Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	enc, err := columncrypto.NewEncryptor(identity.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sealed, err := enc.Encrypt([]byte("synthetic restored credential"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.ExecContext(ctx, `CREATE TABLE public.restore_proof(key_id text, algorithm text, ciphertext bytea, nonce bytea)`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.ExecContext(ctx, `INSERT INTO public.restore_proof VALUES($1,$2,$3,$4)`, sealed.KeyID, sealed.Algorithm, sealed.Ciphertext, sealed.Nonce); err != nil {
+		t.Fatal(err)
+	}
+	return identity
+}
+
+func authenticateRestoreDump(t *testing.T, f fixture, dump []byte) []byte {
+	t.Helper()
+	plain := f.write(t, "dump", dump)
+	sealedPath := filepath.Join(f.root, "dump.aead")
+	restored := filepath.Join(f.root, "restored.dump")
+	if err := EncryptFile(plain, sealedPath, f.passphrase, "database-dump", f.context); err != nil {
+		t.Fatal(err)
+	}
+	if err := DecryptFile(sealedPath, restored, filepath.Join(f.root, "missing-key"), "database-dump", f.context); err == nil {
+		t.Fatal("missing key accepted")
+	}
+	if _, err := os.Stat(restored); !os.IsNotExist(err) {
+		t.Fatal("missing key exposed dump")
+	}
+	if err := DecryptFile(sealedPath, restored, f.passphrase, "database-dump", f.context); err != nil {
+		t.Fatal(err)
+	}
+	recovered, err := os.ReadFile(restored)
+	if err != nil || !bytes.Equal(recovered, dump) {
+		t.Fatal("dump did not authenticate/roundtrip")
+	}
+	return recovered
+}
+
+func restoreKeyProof(t *testing.T, ctx context.Context, f fixture, identity *age.X25519Identity, restoredDB *sql.DB) {
+	t.Helper()
+	// Bundle recovery includes both optional trust directories and the actual
+	// key used by the application's column-encryption implementation.
+	source := filepath.Join(f.root, "keys")
+	if err := os.MkdirAll(filepath.Join(source, "catalog-ca"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(source, "catalog-signature-trust"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for name, value := range map[string]string{"SECRET_KEY": "synthetic-signing-key", "ASTRONOMER_ENCRYPTION_KEY": identity.String(), "catalog-ca/ca.pem": "synthetic-ca", "catalog-signature-trust/key.pub": "synthetic-trust"} {
+		if err := os.WriteFile(filepath.Join(source, name), []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	bundle := filepath.Join(f.root, "keys.tar")
+	bundleCipher := filepath.Join(f.root, "keys.aead")
+	bundlePlain := filepath.Join(f.root, "keys-restored.tar")
+	keys := filepath.Join(f.root, "recovered-keys")
+	for _, err := range []error{CreateKeyBundle(source, bundle), EncryptFile(bundle, bundleCipher, f.passphrase, "key-bundle", f.context), DecryptFile(bundleCipher, bundlePlain, f.passphrase, "key-bundle", f.context), ExtractKeyBundle(bundlePlain, keys)} {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	key, err := os.ReadFile(filepath.Join(keys, "ASTRONOMER_ENCRYPTION_KEY"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	recoveredEnc, err := columncrypto.NewEncryptor(string(key))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var proof columncrypto.Sealed
+	if err := restoredDB.QueryRowContext(ctx, `SELECT key_id,algorithm,ciphertext,nonce FROM public.restore_proof`).Scan(&proof.KeyID, &proof.Algorithm, &proof.Ciphertext, &proof.Nonce); err != nil {
+		t.Fatal(err)
+	}
+	value, err := recoveredEnc.Decrypt(proof)
+	if err != nil || string(value) != "synthetic restored credential" {
+		t.Fatal("restored encrypted column not readable")
+	}
+	for _, name := range []string{"catalog-ca/ca.pem", "catalog-signature-trust/key.pub"} {
+		if _, err := os.ReadFile(filepath.Join(keys, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+}
+
+func restoreContainerCommand(t *testing.T, c *postgres.PostgresContainer) func(...string) int {
+	t.Helper()
+	ctx := t.Context()
+	return func(args ...string) int {
+		t.Helper()
+		code, out, err := c.Exec(ctx, args)
+		if err != nil {
+			t.Fatal(err)
+		}
+		diagnostic, _ := io.ReadAll(out)
+		if code != 0 {
+			t.Logf("command %s failed as observed (exit %d): %s", args[0], code, diagnostic)
+		}
+		return code
+	}
+}
