+`
+
+func (q *Queries) CountProjectedClusterApps(ctx context.Context, clusterID uuid.UUID) (int64, error) {
+	row := q.db.QueryRow(ctx, countProjectedClusterApps, clusterID)
+	var count int64
+	err := row.Scan(&count)
+	return count, err
+}
+
+const listProjectedClusterApps = `-- name: ListProjectedClusterApps :many
+SELECT ic.id, ic.cluster_id, ic.chart_version_id, ic.release_name, ic.namespace, ic.values_override, ic.status, ic.revision, ic.notes, ic.installed_by_id, ic.request_id, ic.tool_slug, ic.preset_used, ic.created_at, ic.updated_at, ic.drift_detected, ic.drift_detail, ic.drift_checked_at, ic.drift_locked_until, ic.drift_claim_token, ic.project_id,
+  (CASE
+    WHEN dt.id IS NULL THEN ic.status
+    WHEN dt.deletion_state = 'deleting' THEN 'uninstalling'
+    WHEN d.phase IN ('failed', 'timed_out', 'rollback_failed') THEN
+      CASE WHEN ic.status IN ('upgrading','pending_upgrade') THEN 'failed_upgrade'
+           WHEN ic.status IN ('rolling_back','pending_rollback') THEN 'failed_rollback'
+           ELSE 'failed_install' END
+    WHEN d.phase = 'degraded' THEN 'degraded'
+    WHEN dt.suspended OR d.phase = 'suspended' THEN 'suspended'
+    WHEN d.phase = 'ready' AND d.desired_generation = dt.generation
+      AND d.observed_generation = d.desired_generation
+      AND d.observed_spec_digest = d.desired_spec_digest THEN 'installed'
+    WHEN d.phase IS NULL OR d.phase IN ('pending','blocked','applying','ready') THEN
+      CASE WHEN ic.status IN ('upgrading','pending_upgrade') THEN 'upgrading'
+           WHEN ic.status IN ('rolling_back','pending_rollback') THEN 'rolling_back'
+           ELSE 'installing' END
+    ELSE 'unknown'
+  END)::text AS projected_status,
+  hcv.version AS chart_version, hcv.app_version AS chart_app_version,
+  hc.id AS chart_id, hc.name AS chart_name, hc.display_name AS chart_display_name,
+  hc.description AS chart_description, hc.icon_url AS chart_icon_url,
+  hc.category AS chart_category, hr.name AS repo_name, hr.repo_type AS repo_type
+FROM installed_charts ic
+LEFT JOIN delivery_targets dt ON dt.id = ic.request_id
+LEFT JOIN cluster_deployments d ON d.target_id = dt.id AND d.cluster_id = ic.cluster_id
+LEFT JOIN helm_chart_versions hcv ON ic.chart_version_id = hcv.id
+LEFT JOIN helm_charts hc ON hcv.chart_id = hc.id
+LEFT JOIN helm_repositories hr ON hc.repository_id = hr.id
+WHERE ic.cluster_id = $1
+  AND COALESCE(dt.deletion_state, 'active') <> 'deleted'
+  AND ic.status <> 'uninstalled'
+ORDER BY ic.created_at DESC, ic.id DESC
+LIMIT $3 OFFSET $2
+`
+
+type ListProjectedClusterAppsParams struct {
+	ClusterID   uuid.UUID `json:"cluster_id"`
+	QueryOffset int32     `json:"query_offset"`
+	QueryLimit  int32     `json:"query_limit"`
+}
+
+type ListProjectedClusterAppsRow struct {
+	InstalledChart   InstalledChart `json:"installed_chart"`
+	ProjectedStatus  string         `json:"projected_status"`
+	ChartVersion     pgtype.Text    `json:"chart_version"`
+	ChartAppVersion  pgtype.Text    `json:"chart_app_version"`
+	ChartID          pgtype.UUID    `json:"chart_id"`
+	ChartName        pgtype.Text    `json:"chart_name"`
+	ChartDisplayName pgtype.Text    `json:"chart_display_name"`
+	ChartDescription pgtype.Text    `json:"chart_description"`
+	ChartIconUrl     pgtype.Text    `json:"chart_icon_url"`
+	ChartCategory    pgtype.Text    `json:"chart_category"`
+	RepoName         pgtype.Text    `json:"repo_name"`
+	RepoType         pgtype.Text    `json:"repo_type"`
+}
+
+// The Apps read model projects durable Delivery state before pagination. It
+// never mutates/deletes compatibility rows while serving a read.
+func (q *Queries) ListProjectedClusterApps(ctx context.Context, arg ListProjectedClusterAppsParams) ([]ListProjectedClusterAppsRow, error) {
+	rows, err := q.db.Query(ctx, listProjectedClusterApps, arg.ClusterID, arg.QueryOffset, arg.QueryLimit)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ListProjectedClusterAppsRow{}
+	for rows.Next() {
+		var i ListProjectedClusterAppsRow
+		if err := rows.Scan(
+			&i.InstalledChart.ID,
+			&i.InstalledChart.ClusterID,
+			&i.InstalledChart.ChartVersionID,
+			&i.InstalledChart.ReleaseName,
+			&i.InstalledChart.Namespace,
+			&i.InstalledChart.ValuesOverride,
+			&i.InstalledChart.Status,
+			&i.InstalledChart.Revision,
+			&i.InstalledChart.Notes,
+			&i.InstalledChart.InstalledByID,
+			&i.InstalledChart.RequestID,
+			&i.InstalledChart.ToolSlug,
+			&i.InstalledChart.PresetUsed,
+			&i.InstalledChart.CreatedAt,
+			&i.InstalledChart.UpdatedAt,
+			&i.InstalledChart.DriftDetected,
+			&i.InstalledChart.DriftDetail,
+			&i.InstalledChart.DriftCheckedAt,
+			&i.InstalledChart.DriftLockedUntil,
+			&i.InstalledChart.DriftClaimToken,
+			&i.InstalledChart.ProjectID,
+			&i.ProjectedStatus,
+			&i.ChartVersion,
+			&i.ChartAppVersion,
+			&i.ChartID,
+			&i.ChartName,
+			&i.ChartDisplayName,
+			&i.ChartDescription,
+			&i.ChartIconUrl,
+			&i.ChartCategory,
+			&i.RepoName,
+			&i.RepoType,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
