+          "type": "string",
+          "minLength": 1,
+          "maxLength": 100
+        },
+        "cluster_id": {
+          "type": "string",
+          "format": "uuid"
+        },
+        "project_id": {
+          "type": "string",
+          "format": "uuid"
+        },
+        "namespace": {
+          "type": "string",
+          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
+          "maxLength": 63
+        },
+        "expected_privilege_profile": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 100
+        },
+        "observed_privilege_profile": {
+          "type": "string",
+          "maxLength": 100
+        },
+        "status": {
+          "type": "string",
