+//go:build integration
+
+package catalog
+
+import (
+	"io"
+	"log"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	distribution "github.com/google/go-containerregistry/pkg/registry"
+	"github.com/google/uuid"
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+	"helm.sh/helm/v4/pkg/chart/v2/util"
+	"helm.sh/helm/v4/pkg/registry"
+
+	"github.com/alphabravocompany/astronomer-go/internal/db/sqlc"
+	"github.com/alphabravocompany/astronomer-go/internal/testdb"
+)
+
+// A real distribution registry serves uploaded Helm archives over TLS. The
+// operation-scoped client trusts only this owned server; public-host guards are
+// covered separately. PostgreSQL runs the production migrations.
+func TestOCIIngestionPersistsVersionsAndConverges(t *testing.T) {
+	t.Parallel()
+	server := httptest.NewTLSServer(distribution.New(distribution.Logger(log.New(io.Discard, "", 0))))
+	t.Cleanup(server.Close)
+	client := server.Client()
+	client.Timeout = 20 * time.Second
+	publisher, err := registry.NewClient(registry.ClientOptHTTPClient(client), registry.ClientOptWriter(io.Discard))
+	if err != nil {
+		t.Fatal(err)
+	}
+	host := strings.TrimPrefix(server.URL, "https://")
+	for _, version := range []string{"1.0.0", "1.1.0"} {
+		file, err := util.Save(&chart.Chart{Metadata: &chart.Metadata{APIVersion: "v2", Name: "owned-chart", Version: version, Description: "owned OCI integration", AppVersion: "2.0"}}, t.TempDir())
+		if err != nil {
+			t.Fatal(err)
+		}
+		archive, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := publisher.Push(archive, host+"/charts/owned-chart:"+version); err != nil {
+			t.Fatal(err)
+		}
+	}
+	pool := testdb.Pool(t)
+	q := sqlc.New(pool)
+	ctx := WithNetworkClient(t.Context(), client)
+	repo := sqlc.HelmRepository{ID: uuid.New(), Url: "oci://" + host + "/charts", RepoType: "oci", AuthConfig: []byte(`{"charts":["owned-chart"]}`)}
+	_, err = pool.Exec(ctx, `INSERT INTO helm_repositories(id,name,url,repo_type,auth_config) VALUES($1,$2,$3,'oci',$4)`, repo.ID, repo.ID.String(), repo.Url, repo.AuthConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, wanted := range []int{2, 0} {
+		charts, versions, err := IngestOCIRepo(ctx, q, repo, nil, nil)
+		if err != nil || charts != 1 || versions != wanted {
+			t.Fatalf("ingest %d: charts=%d versions=%d err=%v", i, charts, versions, err)
+		}
+	}
+	row, err := q.GetHelmChartByRepoAndName(ctx, sqlc.GetHelmChartByRepoAndNameParams{RepositoryID: repo.ID, Name: "owned-chart"})
+	if err != nil || row.Description != "owned OCI integration" {
+		t.Fatalf("persisted metadata: %v %v", row, err)
+	}
+	for _, version := range []string{"1.0.0", "1.1.0"} {
+		persisted, err := q.GetHelmChartVersion(ctx, sqlc.GetHelmChartVersionParams{ChartID: row.ID, Version: version})
+		if err != nil || persisted.AppVersion != "2.0" {
+			t.Fatalf("persisted version %s: %v", version, err)
+		}
+	}
+}
diff --git a/internal/db/queries/catalog_app_projection.sql b/internal/db/queries/catalog_app_projection.sql
new file mode 100644
index 0000000000..e3e19b4c7c
--- /dev/null
+++ b/internal/db/queries/catalog_app_projection.sql
@@ -0,0 +1,44 @@
+-- The Apps read model projects durable Delivery state before pagination. It
+-- never mutates/deletes compatibility rows while serving a read.
+-- name: ListProjectedClusterApps :many
+SELECT sqlc.embed(ic),
+  (CASE
+    WHEN dt.id IS NULL THEN ic.status
+    WHEN dt.deletion_state = 'deleting' THEN 'uninstalling'
+    WHEN d.phase IN ('failed', 'timed_out', 'rollback_failed') THEN
+      CASE WHEN ic.status IN ('upgrading','pending_upgrade') THEN 'failed_upgrade'
+           WHEN ic.status IN ('rolling_back','pending_rollback') THEN 'failed_rollback'
+           ELSE 'failed_install' END
+    WHEN d.phase = 'degraded' THEN 'degraded'
+    WHEN dt.suspended OR d.phase = 'suspended' THEN 'suspended'
+    WHEN d.phase = 'ready' AND d.desired_generation = dt.generation
+      AND d.observed_generation = d.desired_generation
+      AND d.observed_spec_digest = d.desired_spec_digest THEN 'installed'
+    WHEN d.phase IS NULL OR d.phase IN ('pending','blocked','applying','ready') THEN
+      CASE WHEN ic.status IN ('upgrading','pending_upgrade') THEN 'upgrading'
+           WHEN ic.status IN ('rolling_back','pending_rollback') THEN 'rolling_back'
+           ELSE 'installing' END
+    ELSE 'unknown'
+  END)::text AS projected_status,
+  hcv.version AS chart_version, hcv.app_version AS chart_app_version,
+  hc.id AS chart_id, hc.name AS chart_name, hc.display_name AS chart_display_name,
+  hc.description AS chart_description, hc.icon_url AS chart_icon_url,
+  hc.category AS chart_category, hr.name AS repo_name, hr.repo_type AS repo_type
+FROM installed_charts ic
+LEFT JOIN delivery_targets dt ON dt.id = ic.request_id
+LEFT JOIN cluster_deployments d ON d.target_id = dt.id AND d.cluster_id = ic.cluster_id
+LEFT JOIN helm_chart_versions hcv ON ic.chart_version_id = hcv.id
+LEFT JOIN helm_charts hc ON hcv.chart_id = hc.id
+LEFT JOIN helm_repositories hr ON hc.repository_id = hr.id
+WHERE ic.cluster_id = sqlc.arg(cluster_id)
+  AND COALESCE(dt.deletion_state, 'active') <> 'deleted'
+  AND ic.status <> 'uninstalled'
+ORDER BY ic.created_at DESC, ic.id DESC
+LIMIT sqlc.arg(query_limit) OFFSET sqlc.arg(query_offset);
+
+-- name: CountProjectedClusterApps :one
+SELECT count(*) FROM installed_charts ic
+LEFT JOIN delivery_targets dt ON dt.id = ic.request_id
+WHERE ic.cluster_id = $1
+  AND COALESCE(dt.deletion_state, 'active') <> 'deleted'
+  AND ic.status <> 'uninstalled';
