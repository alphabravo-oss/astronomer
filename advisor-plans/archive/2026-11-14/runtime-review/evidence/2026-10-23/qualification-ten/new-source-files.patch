diff --git a/frontend/scripts/build-monaco.mjs b/frontend/scripts/build-monaco.mjs
new file mode 100644
index 0000000000..78f1cce0cb
--- /dev/null
+++ b/frontend/scripts/build-monaco.mjs
@@ -0,0 +1,88 @@
+import { createHash } from "node:crypto";
+import { lockedSanitizerPlugin } from "./monaco-sanitizer-plugin.mjs";
+import { build } from "vite";
+import { readFile, writeFile, mkdir, readdir } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+
+const path = (relative) => fileURLToPath(new URL(relative, import.meta.url));
+const monaco = JSON.parse(
+  await readFile(
+    new URL("../node_modules/monaco-editor/package.json", import.meta.url),
+    "utf8",
+  ),
+);
+const purify = JSON.parse(
+  await readFile(
+    new URL("../node_modules/dompurify/package.json", import.meta.url),
+    "utf8",
+  ),
+);
+
+// WORKAROUND: https://github.com/microsoft/monaco-editor/issues/5517
+// Rebuild Monaco ESM with the locked sanitizer instead of its vendored copy.
+await build({
+  configFile: false,
+  base: "/monaco/",
+  publicDir: false,
+  plugins: [lockedSanitizerPlugin()],
+  build: {
+    outDir: path("../public/monaco"),
+    emptyOutDir: true,
+    assetsInlineLimit: 0,
+    cssCodeSplit: false,
+    rollupOptions: {
+      input: {
+        editor: path(
+          "../node_modules/monaco-editor/esm/vs/editor/editor.main.js",
+        ),
+        "editor.worker": path(
+          "../node_modules/monaco-editor/esm/vs/editor/editor.worker.js",
+        ),
+        "json.worker": path(
+          "../node_modules/monaco-editor/esm/vs/language/json/json.worker.js",
+        ),
+        "css.worker": path(
+          "../node_modules/monaco-editor/esm/vs/language/css/css.worker.js",
+        ),
+        "html.worker": path(
+          "../node_modules/monaco-editor/esm/vs/language/html/html.worker.js",
+        ),
+        "ts.worker": path(
+          "../node_modules/monaco-editor/esm/vs/language/typescript/ts.worker.js",
+        ),
+      },
+      preserveEntrySignatures: "strict",
+      output: {
+        format: "es",
+        entryFileNames: "[name].js",
+        assetFileNames: (asset) =>
+          asset.names.some((name) => name.endsWith(".css"))
+            ? "editor.css"
+            : "assets/[name]-[hash][extname]",
+      },
+    },
+  },
+});
+await mkdir(path("../public/monaco"), { recursive: true });
+const hashes = {};
+for (const entry of await readdir(path("../public/monaco"), {
+  recursive: true,
+  withFileTypes: true,
+})) {
+  if (!entry.isFile()) continue;
+  const full = `${entry.parentPath}/${entry.name}`;
+  const relative = full.slice(path("../public/monaco").length + 1);
+  hashes[relative] = createHash("sha256")
+    .update(await readFile(full))
+    .digest("hex");
+}
+await writeFile(
+  path("../public/monaco/build.json"),
+  JSON.stringify({
+    files: hashes,
+    monaco: monaco.version,
+    dompurify: purify.version,
+    sanitizer: "locked-package-esm",
+    vendoredSanitizer: false,
+  }) + "\n",
+);
diff --git a/frontend/scripts/check-editor-sanitizer.test.mjs b/frontend/scripts/check-editor-sanitizer.test.mjs
new file mode 100644
index 0000000000..31854f6d01
--- /dev/null
+++ b/frontend/scripts/check-editor-sanitizer.test.mjs
@@ -0,0 +1,82 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { JSDOM } from "jsdom";
+
+import { build } from "vite";
+import { fileURLToPath } from "node:url";
+import { lockedSanitizerPlugin } from "./monaco-sanitizer-plugin.mjs";
+// Build the real Monaco sanitizer through the same guarded resolver as production.
+const dom = new JSDOM("<!doctype html><html><body></body></html>");
+for (const name of [
+  "window",
+  "document",
+  "customElements",
+  "MutationObserver",
+  "Node",
+  "HTMLElement",
+  "HTMLAnchorElement",
+  "HTMLImageElement",
+  "HTMLInputElement",
+  "DocumentFragment",
+  "DOMParser",
+  "Element",
+]) {
+  if (dom.window[name]) globalThis[name] = dom.window[name];
+}
+const built = await build({
+  configFile: false,
+  publicDir: false,
+  logLevel: "silent",
+  plugins: [lockedSanitizerPlugin()],
+  build: {
+    write: false,
+    lib: {
+      entry: fileURLToPath(
+        new URL(
+          "../node_modules/monaco-editor/esm/vs/base/browser/domSanitize.js",
+          import.meta.url,
+        ),
+      ),
+      formats: ["es"],
+    },
+  },
+});
+const code = built[0].output.find(
+  (entry) => entry.type === "chunk" && entry.isEntry,
+).code;
+const { sanitizeHtml } = await import(
+  `data:text/javascript;base64,${Buffer.from(code).toString("base64")}`
+);
+
+test("Monaco removes executable tags, handlers and dangerous link protocols", () => {
+  for (const input of [
+    '<img src="x" onerror="alert(1)"><script>alert(1)</script>',
+    '<a href="javascript:alert(1)">unsafe link</a>',
+    '<svg><a xlink:href="javascript:alert(1)">unsafe SVG</a></svg>',
+    '<math><mtext><img src="x" onerror="alert(1)"></mtext></math>',
+  ]) {
+    const output = document.createElement("div");
+    output.innerHTML = String(sanitizeHtml(input));
+    assert.equal(output.querySelector("script,svg,math,iframe,object"), null);
+    for (const element of output.querySelectorAll("*")) {
+      for (const attribute of element.attributes) {
+        assert.ok(!attribute.name.startsWith("on"));
+        assert.ok(!attribute.value.toLowerCase().includes("javascript:"));
+      }
+    }
+  }
+});
+
+test("Monaco preserves permitted markup and HTTPS links", () => {
+  const output = document.createElement("div");
+  output.innerHTML = String(
+    sanitizeHtml(
+      '<strong>Safe</strong> <a href="https://example.com">link</a>',
+    ),
+  );
+  assert.equal(output.querySelector("strong")?.textContent, "Safe");
+  assert.equal(
+    output.querySelector("a")?.getAttribute("href"),
+    "https://example.com",
+  );
+});
