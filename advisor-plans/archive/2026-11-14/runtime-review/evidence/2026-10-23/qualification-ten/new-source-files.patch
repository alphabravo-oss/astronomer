@@ -0,0 +1,34 @@
+import { fileURLToPath } from "node:url";
+export function lockedSanitizerPlugin() {
+  const patched = fileURLToPath(
+    new URL("../node_modules/dompurify/dist/purify.es.mjs", import.meta.url),
+  );
+  let replacementUsed = false;
+  return {
+    name: "monaco-locked-sanitizer",
+    enforce: "pre",
+    resolveId(source, importer) {
+      if (
+        source === "./dompurify/dompurify.js" &&
+        importer?.endsWith("/vs/base/browser/domSanitize.js")
+      ) {
+        replacementUsed = true;
+        return patched;
+      }
+    },
+    generateBundle() {
+      const modules = [...this.getModuleIds()];
+      if (
+        !replacementUsed ||
+        !modules.includes(patched) ||
+        modules.some((id) =>
+          id.endsWith("/vs/base/browser/dompurify/dompurify.js"),
+        )
+      ) {
+        throw new Error(
+          "Monaco must use the locked DOMPurify package, never its vendored copy",
+        );
+      }
+    },
+  };
+}
diff --git a/frontend/scripts/verify-editor-build.mjs b/frontend/scripts/verify-editor-build.mjs
new file mode 100644
index 0000000000..050d5f4192
--- /dev/null
+++ b/frontend/scripts/verify-editor-build.mjs
@@ -0,0 +1,54 @@
+import { readFile, readdir } from "node:fs/promises";
+import { createHash } from "node:crypto";
+export async function verifyEditorBuild(directory) {
+  const manifest = JSON.parse(
+    await readFile(new URL("build.json", directory), "utf8"),
+  );
+  const lock = JSON.parse(
+    await readFile(new URL("../package-lock.json", import.meta.url), "utf8"),
+  );
+  if (
+    manifest.dompurify !== lock.packages["node_modules/dompurify"].version ||
+    manifest.monaco !== lock.packages["node_modules/monaco-editor"].version ||
+    manifest.sanitizer !== "locked-package-esm" ||
+    manifest.vendoredSanitizer !== false
+  ) {
+    throw new Error(
+      "Editor sanitizer provenance differs from locked source build",
+    );
+  }
+  for (const required of [
+    "editor.js",
+    "editor.css",
+    "editor.worker.js",
+    "json.worker.js",
+    "css.worker.js",
+    "html.worker.js",
+    "ts.worker.js",
+  ]) {
+    if (!manifest.files?.[required])
+      throw new Error(`Missing editor asset: ${required}`);
+  }
+  const files = (await readdir(directory, { recursive: true })).filter(
+    (name) => name !== "build.json",
+  );
+  const actual = [];
+  for (const name of files) {
+    if (name.includes("..") || name.startsWith("/"))
+      throw new Error("Invalid editor asset path");
+    let bytes;
+    try {
+      bytes = await readFile(new URL(name, directory));
+    } catch (error) {
+      if (error.code === "EISDIR") continue;
+      throw error;
+    }
+    actual.push(name);
+    if (
+      createHash("sha256").update(bytes).digest("hex") !== manifest.files[name]
+    )
+      throw new Error(`Editor asset hash mismatch: ${name}`);
+  }
+  if (actual.length !== Object.keys(manifest.files).length)
+    throw new Error("Editor asset inventory mismatch");
+}
