+			restored := filepath.Join(root, "restored")
+			runBackupCryptoCLI(t, binary, "key-bundle-extract", "--input", plain, "--output", restored)
+			for _, name := range []string{"SECRET_KEY", "ASTRONOMER_ENCRYPTION_KEY"} {
+				if _, err := os.Stat(filepath.Join(restored, name)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, item := range []struct {
+				enabled   bool
+				directory string
+			}{{tc.ca, "catalog-ca"}, {tc.signature, "catalog-signature-trust"}} {
+				if !item.enabled {
+					continue
+				}
+				entries, err := os.ReadDir(filepath.Join(restored, item.directory))
+				if err != nil || len(entries) != len(trust) {
+					t.Fatalf("wrong restored trust inventory: %v", err)
+				}
+				for name, want := range trust {
+					got, err := os.ReadFile(filepath.Join(restored, item.directory, name))
+					if err != nil || string(got) != want {
+						t.Fatalf("trust file %s changed: %v", name, err)
+					}
+				}
+			}
+		})
+	}
+}
+
+func projectedBackupSecret(t *testing.T, directory string, files map[string]string) {
+	t.Helper()
+	version := filepath.Join(directory, "..version")
+	if err := os.MkdirAll(version, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("..version", filepath.Join(directory, "..data")); err != nil {
+		t.Fatal(err)
+	}
+	for name, content := range files {
+		if err := os.WriteFile(filepath.Join(version, name), []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(filepath.Join("..data", name), filepath.Join(directory, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func runBackupCryptoCLI(t *testing.T, binary string, args ...string) {
+	t.Helper()
+	if output, err := exec.CommandContext(t.Context(), binary, args...).CombinedOutput(); err != nil {
+		t.Fatalf("crypto CLI failed: %v\n%s", err, output)
+	}
+}
diff --git a/internal/agent/delivery/system_health.go b/internal/agent/delivery/system_health.go
new file mode 100644
index 0000000000..20c00f13f2
--- /dev/null
+++ b/internal/agent/delivery/system_health.go
@@ -0,0 +1,52 @@
+package delivery
+
+import (
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+)
+
+func sourceControllerWarmStandbyReady(item *appsv1.Deployment) bool {
+	if item == nil || item.Name != "source-controller" || item.Namespace != DeliverySystemNamespace || item.DeletionTimestamp != nil {
+		return false
+	}
+	desired := int32(1)
+	if item.Spec.Replicas != nil {
+		desired = *item.Spec.Replicas
+	}
+	if desired < 1 || item.Generation < 1 || item.Status.ObservedGeneration != item.Generation ||
+		item.Status.UpdatedReplicas != desired || item.Status.Replicas != desired ||
+		item.Status.AvailableReplicas < 1 || item.Status.ReadyReplicas < 1 {
+		return false
+	}
+	for _, condition := range item.Status.Conditions {
+		if condition.Type == appsv1.DeploymentReplicaFailure && condition.Status == corev1.ConditionTrue {
+			return false
+		}
+	}
+	return true
+}
+
+// Flux v2.9.6 evaluates these before its built-in Deployment status reader.
+// The exception is limited to the artifact-serving leader and its intentional
+// warm standby. All replicas must belong to the observed generation, so an old
+// available leader cannot make a failed upgrade look complete. Other system
+// Deployments still require every desired replica to be ready and available.
+// Keep these predicates aligned with sourceControllerWarmStandbyReady; tests
+// evaluate the emitted CEL and the Go readiness check against the same states.
+func systemDeploymentHealthChecks() []any {
+	source := "(metadata.name == 'source-controller' && metadata.namespace == '" + DeliverySystemNamespace + "')"
+	observed := "has(metadata.generation) && metadata.generation > 0 && has(status.observedGeneration) && status.observedGeneration == metadata.generation"
+	rolledOut := "!has(metadata.deletionTimestamp) && (" + observed + ") && has(spec.replicas) && spec.replicas > 0 && " +
+		"has(status.updatedReplicas) && status.updatedReplicas == spec.replicas && has(status.replicas) && status.replicas == spec.replicas"
+	replicaFailure := "(has(status.conditions) && status.conditions.exists(c, c.type == 'ReplicaFailure' && c.status == 'True'))"
+	available := "has(status.availableReplicas) && has(status.readyReplicas) && (" + source +
+		" ? status.availableReplicas > 0 && status.readyReplicas > 0 : status.availableReplicas >= spec.replicas && status.readyReplicas >= spec.replicas)"
+	current := "(" + rolledOut + ") && (" + available + ") && !" + replicaFailure
+	deadline := "(has(status.conditions) && status.conditions.exists(c, c.type == 'Progressing' && c.status == 'False' && has(c.reason) && c.reason == 'ProgressDeadlineExceeded'))"
+	return []any{map[string]any{
+		"apiVersion": "apps/v1", "kind": "Deployment",
+		"inProgress": "!(" + observed + ")",
+		"failed":     replicaFailure + " || (" + deadline + " && !(" + source + " && (" + current + ")))",
+		"current":    current,
+	}}
+}
diff --git a/internal/agent/delivery/system_health_test.go b/internal/agent/delivery/system_health_test.go
new file mode 100644
index 0000000000..4f865e629a
--- /dev/null
+++ b/internal/agent/delivery/system_health_test.go
@@ -0,0 +1,150 @@
+package delivery
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/google/cel-go/cel"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+)
+
+func TestSystemDeploymentHealth(t *testing.T) {
+	t.Parallel()
+	checks := systemDeploymentHealthChecks()
+	expressions := checks[0].(map[string]any)
+	programs := compileDeploymentHealth(t, expressions)
+	fixtures := []map[string]any{}
+	for _, tc := range []struct {
+		name   string
+		mutate func(*appsv1.Deployment)
+		state  string
+		health string
+	}{
+		{"leader and standby beyond deadline", func(*appsv1.Deployment) {}, "current", "healthy"},
+		{"leader lost", func(d *appsv1.Deployment) { d.Status.AvailableReplicas = 0; d.Status.ReadyReplicas = 0 }, "failed", "unavailable"},
+		{"artifact endpoint unavailable", func(d *appsv1.Deployment) { d.Status.ReadyReplicas = 0 }, "failed", "unavailable"},
+		{"leader recovering", func(d *appsv1.Deployment) {
+			d.Status.AvailableReplicas = 0
+			d.Status.ReadyReplicas = 0
+			d.Status.Conditions = nil
+		}, "inProgress", "unavailable"},
+		{"unobserved generation", func(d *appsv1.Deployment) { d.Generation++ }, "inProgress", "degraded"},
+		{"missing observed generation", func(d *appsv1.Deployment) { d.Status.ObservedGeneration = 0 }, "inProgress", "degraded"},
+		{"old leader while new revision fails", func(d *appsv1.Deployment) { d.Status.UpdatedReplicas = 1 }, "failed", "degraded"},
+		{"extra old replica", func(d *appsv1.Deployment) { d.Status.Replicas = 3 }, "failed", "degraded"},
+		{"missing standby replica", func(d *appsv1.Deployment) { d.Status.Replicas = 1 }, "failed", "degraded"},
+		{"replica creation failure", func(d *appsv1.Deployment) {
+			d.Status.Conditions = append(d.Status.Conditions, appsv1.DeploymentCondition{Type: appsv1.DeploymentReplicaFailure, Status: corev1.ConditionTrue})
+		}, "failed", "degraded"},
+		{"scaled to zero", func(d *appsv1.Deployment) {
+			*d.Spec.Replicas = 0
+			d.Status = appsv1.DeploymentStatus{ObservedGeneration: d.Generation}
+		}, "inProgress", "unavailable"},
+		{"deleting", func(d *appsv1.Deployment) { now := metav1.Now(); d.DeletionTimestamp = &now }, "failed", "degraded"},
+		{"ordinary controller unavailable", func(d *appsv1.Deployment) { d.Name = "helm-controller" }, "failed", "degraded"},
+		{"same name outside system", func(d *appsv1.Deployment) { d.Namespace = "other" }, "failed", "degraded"},
+		{"ordinary controller complete", func(d *appsv1.Deployment) {
+			d.Name = "helm-controller"
+			d.Status.AvailableReplicas = 2
+			d.Status.ReadyReplicas = 2
+			d.Status.Conditions = nil
+		}, "current", "healthy"},
+	} {
+		item := readyController(t, "source-controller", false)
+		item.TypeMeta = metav1.TypeMeta{APIVersion: "apps/v1", Kind: "Deployment"}
+		replicas := int32(2)
+		item.Spec.Replicas = &replicas
+		item.Status.Replicas = 2
+		item.Status.UpdatedReplicas = 2
+		item.Status.Conditions = []appsv1.DeploymentCondition{
+			{Type: appsv1.DeploymentAvailable, Status: corev1.ConditionFalse},
+			{Type: appsv1.DeploymentProgressing, Status: corev1.ConditionFalse, Reason: "ProgressDeadlineExceeded"},
+		}
+		tc.mutate(item)
+		object, err := runtime.DefaultUnstructuredConverter.ToUnstructured(item)
+		if err != nil {
+			t.Fatal(err)
+		}
+		fixtures = append(fixtures, map[string]any{"name": tc.name, "object": object, "expected": tc.state})
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			if got := evaluateDeploymentHealth(t, programs, object); got != tc.state {
+				t.Fatalf("Flux health = %s, want %s", got, tc.state)
+			}
+			identity := componentIdentity{category: "delivery", owner: "astronomer", method: "flux"}
+			component := deploymentComponent(item, identity)
+			if component.Health != tc.health {
+				t.Fatalf("inventory health = %s, want %s", component.Health, tc.health)
+			}
+			if component.DesiredReplicas != *item.Spec.Replicas || component.ReadyReplicas != item.Status.ReadyReplicas {
+				t.Fatal("inventory changed actual replica counts")
+			}
+			if item.Name == "source-controller" && item.Namespace == DeliverySystemNamespace {
+				if got := deploymentReady(item, item.Name); got != (tc.state == "current") {
+					t.Fatalf("probe readiness = %v, want %v", got, tc.state == "current")
+				}
+			}
+		})
+	}
+	// Verbose output also supplies sanitized fixtures to the pinned Flux runtime
+	// compatibility check, without exposing cluster data or modifying source.
+	evidence, err := json.Marshal(map[string]any{"checks": checks, "fixtures": fixtures})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("FLUX_HEALTH_FIXTURES=%s", evidence)
+}
+
+func compileDeploymentHealth(t *testing.T, expressions map[string]any) map[string]cel.Program {
+	t.Helper()
+	env, err := cel.NewEnv(cel.Variable("metadata", cel.DynType), cel.Variable("spec", cel.DynType), cel.Variable("status", cel.DynType))
+	if err != nil {
+		t.Fatal(err)
+	}
+	programs := map[string]cel.Program{}
+	for _, name := range []string{"inProgress", "failed", "current"} {
+		ast, issues := env.Compile(expressions[name].(string))
+		if issues.Err() != nil {
+			t.Fatalf("invalid %s: %v", name, issues.Err())
+		}
+		program, err := env.Program(ast)
+		if err != nil {
+			t.Fatal(err)
+		}
+		programs[name] = program
+	}
+	return programs
+}
+
+func evaluateDeploymentHealth(t *testing.T, programs map[string]cel.Program, object map[string]any) string {
+	t.Helper()
+	for _, name := range []string{"inProgress", "failed", "current"} {
+		result, _, err := programs[name].Eval(object)
+		if err != nil {
+			t.Fatalf("evaluate %s: %v", name, err)
+		}
+		if result.Value() == true {
+			return name
+		}
+	}
+	return "inProgress"
+}
+
+func TestSystemObjectsRetainWaitAndDeploymentHealthChecks(t *testing.T) {
+	t.Parallel()
+	objects := systemObjects(systemReleaseFixture())
+	kustomization := objects[len(objects)-1]
+	wait, _, err := unstructured.NestedBool(kustomization.Object, "spec", "wait")
+	if err != nil || !wait {
+		t.Fatal("system rollout must wait for resource health")
+	}
+	checks, found, err := unstructured.NestedSlice(kustomization.Object, "spec", "healthCheckExprs")
+	if err != nil || !found || len(checks) != 1 {
+		t.Fatal("missing Deployment health expressions")
+	}
+	compileDeploymentHealth(t, checks[0].(map[string]any))
+}
