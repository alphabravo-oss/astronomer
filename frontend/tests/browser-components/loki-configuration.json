{
  "version": "7.3.0",
  "appVersion": "3.6.12",
  "artifact": {
    "type": "helm-http",
    "repository": "grafana",
    "name": "loki",
    "version": "7.3.0",
    "digest": "sha256:04a339f712d770a1f599f05fc0a5a3cde18e43914e49ae6a49f7171be86bcc09"
  },
  "identities": {
    "chartDigest": "sha256:04a339f712d770a1f599f05fc0a5a3cde18e43914e49ae6a49f7171be86bcc09"
  },
  "available": true,
  "recommended": true,
  "supportTier": "experimental",
  "compatibility": {
    "kubernetes": ">=1.31.0 <1.36.0"
  },
  "configuration": {
    "schema": {
      "type": "object",
      "properties": {
        "deploymentMode": {
          "type": "string",
          "default": "SimpleScalable",
          "title": "Deployment mode",
          "enum": ["SingleBinary", "SimpleScalable", "Distributed"]
        },
        "singleBinary": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "default": 0,
              "title": "Single binary replicas",
              "minimum": 0
            },
            "persistence": {
              "type": "object",
              "title": "Log storage",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "title": "Retain logs on a persistent volume"
                },
                "size": {
                  "type": "string",
                  "default": "10Gi",
                  "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                  "title": "Volume size"
                },
                "storageClass": {
                  "type": ["string", "null"],
                  "x-astronomer-resource": "storageclasses",
                  "description": "Leave empty to use the cluster default StorageClass.",
                  "title": "StorageClass"
                }
              }
            }
          },
          "x-astronomer-show-when": {
            "path": "deploymentMode",
            "equals": "SingleBinary"
          },
          "title": "Single replica"
        },
        "loki": {
          "type": "object",
          "properties": {
            "auth_enabled": {
              "type": "boolean",
              "default": true,
              "title": "Enable tenant authentication"
            },
            "storage": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "default": "s3",
                  "title": "Storage type",
                  "enum": [
                    "filesystem",
                    "s3",
                    "gcs",
                    "azure",
                    "swift",
                    "alibabacloud",
                    "bos",
                    "cos"
                  ]
                },
                "bucketNames": {
                  "type": "object",
                  "properties": {
                    "chunks": {
                      "type": "string",
                      "title": "Chunks bucket"
                    },
                    "ruler": {
                      "type": "string",
                      "title": "Ruler bucket"
                    },
                    "admin": {
                      "type": "string",
                      "title": "Admin bucket"
                    }
                  },
                  "x-astronomer-show-when": {
                    "path": "loki.storage.type",
                    "equals": "s3"
                  }
                }
              }
            },
            "commonConfig": {
              "type": "object",
              "properties": {
                "replication_factor": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "Replication factor"
                }
              }
            }
          },
          "title": "Storage and authentication"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "title": "Enable gateway"
            }
          },
          "title": "Gateway"
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "title": "Create ServiceMonitor"
                }
              }
            }
          },
          "title": "Metrics integration"
        },
        "read": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "title": "Read replicas"
            }
          },
          "title": "Read workloads",
          "x-astronomer-advanced": true
        },
        "write": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "title": "Write replicas"
            }
          },
          "title": "Write workloads",
          "x-astronomer-advanced": true
        },
        "backend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "title": "Backend replicas"
            }
          },
          "title": "Backend workloads",
          "x-astronomer-advanced": true
        }
      }
    },
    "presets": [
      {
        "id": "evaluation",
        "label": "Single replica evaluation",
        "description": "Ephemeral filesystem storage on one replica. Logs are lost when the pod is replaced. For evaluation only.",
        "values": {
          "deploymentMode": "SingleBinary",
          "loki": {
            "auth_enabled": false,
            "commonConfig": {
              "replication_factor": 1
            },
            "storage": {
              "type": "filesystem"
            },
            "schemaConfig": {
              "configs": [
                {
                  "from": "2024-04-01",
                  "store": "tsdb",
                  "object_store": "filesystem",
                  "schema": "v13",
                  "index": {
                    "prefix": "loki_index_",
                    "period": "24h"
                  }
                }
              ]
            }
          },
          "singleBinary": {
            "replicas": 1,
            "persistence": {
              "enabled": false
            }
          },
          "read": {
            "replicas": 0
          },
          "write": {
            "replicas": 0
          },
          "backend": {
            "replicas": 0
          },
          "chunksCache": {
            "enabled": false
          },
          "resultsCache": {
            "enabled": false
          }
        }
      },
      {
        "id": "persistent",
        "label": "Persistent single replica",
        "description": "One replica with a 50Gi persistent volume. Select a StorageClass and review capacity and retention. This configuration is not highly available.",
        "values": {
          "deploymentMode": "SingleBinary",
          "loki": {
            "auth_enabled": false,
            "commonConfig": {
              "replication_factor": 1
            },
            "storage": {
              "type": "filesystem"
            },
            "schemaConfig": {
              "configs": [
                {
                  "from": "2024-04-01",
                  "store": "tsdb",
                  "object_store": "filesystem",
                  "schema": "v13",
                  "index": {
                    "prefix": "loki_index_",
                    "period": "24h"
                  }
                }
              ]
            }
          },
          "singleBinary": {
            "replicas": 1,
            "persistence": {
              "enabled": true,
              "size": "50Gi"
            }
          },
          "read": {
            "replicas": 0
          },
          "write": {
            "replicas": 0
          },
          "backend": {
            "replicas": 0
          },
          "chunksCache": {
            "enabled": false
          },
          "resultsCache": {
            "enabled": false
          }
        }
      }
    ],
    "defaultPreset": "evaluation",
    "namespace": "astronomer-loki"
  }
}
