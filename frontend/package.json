{
  "name": "astronomer-frontend",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prepare-static-assets.mjs",
    "build": "npm run type-check && vite build && node scripts/check-csp-build.mjs",
    "bundle:check": "node --test scripts/check-bundle-budget.test.mjs && node scripts/check-bundle-budget.mjs",
    "prebuild": "node scripts/prepare-static-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "node scripts/check-staged-formatting.mjs",
    "format:test": "node --test scripts/check-staged-formatting.test.mjs",
    "openapi:generate": "python3 ../scripts/categorical-contracts.py write && node ../scripts/generate-openapi-types.mjs --write && node ../scripts/generate-openapi-client.mjs --write",
    "openapi:check": "python3 ../scripts/categorical-contracts.py check-browser && node ../scripts/generate-openapi-types.mjs --check && node ../scripts/generate-openapi-client.mjs --check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:browser-components": "node scripts/prepare-static-assets.mjs",
    "test:browser-components": "playwright test --config=playwright.components.config.ts",
    "test:e2e": "playwright test --config=playwright.live.config.ts",
    "pretest:e2e:visual": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium --project=tablet-chromium --project=mobile-chromium",
    "pretest:e2e:stubbed": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e:stubbed": "playwright test --project=chromium --project=mobile-chromium",
    "test:editor-sanitizer": "node scripts/build-monaco.mjs && node --test scripts/check-editor-sanitizer.test.mjs scripts/verify-editor-build.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@wterm/core": "0.5.10",
    "@wterm/dom": "0.5.10",
    "@wterm/react": "0.5.10",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "dompurify": "3.4.17",
    "nanoid": "3.3.20",
    "postcss": "8.5.29"
  }
}
