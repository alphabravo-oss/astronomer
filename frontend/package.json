{
  "name": "astronomer-frontend",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1 <27",
    "npm": ">=12.2.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prepare-static-assets.mjs",
    "build": "npm run type-check && vite build && node scripts/check-csp-build.mjs",
    "bundle:check": "node --test scripts/check-bundle-budget.test.mjs && node scripts/check-bundle-budget.mjs",
    "prebuild": "node scripts/prepare-static-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "node scripts/check-staged-formatting.mjs",
    "format:test": "node --test scripts/check-staged-formatting.test.mjs",
    "code-health": "npm run openapi:check && node ../scripts/check-frontend-raw-transport.mjs && node ../scripts/check-frontend-query-cancellation.mjs && node ../scripts/check-node-version-alignment.mjs && node ../scripts/code-health-inventory.mjs --check --verify-doc && node ../scripts/operation-task-inventory.mjs --check --verify-doc",
    "raw-transport:check": "node ../scripts/check-frontend-raw-transport.mjs",
    "openapi:generate": "node ../scripts/generate-openapi-types.mjs --write && node ../scripts/generate-openapi-client.mjs --write",
    "openapi:check": "node ../scripts/generate-openapi-types.mjs --check && node ../scripts/generate-openapi-client.mjs --check",
    "openapi:types": "npm run openapi:generate",
    "openapi:types:check": "npm run openapi:check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser-components": "playwright test --config=playwright.components.config.ts",
    "pretest:e2e": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "pretest:e2e:smoke": "node scripts/generate-route-manifest.mjs && node scripts/generate-e2e-stubs.mjs",
    "test:e2e:smoke": "playwright test --project=route-smoke --project=route-smoke-mobile",
    "pretest:e2e:visual": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium --project=tablet-chromium --project=mobile-chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "@wterm/core": "0.5.4",
    "@wterm/dom": "0.5.4",
    "@wterm/react": "0.5.4",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "js-yaml": "5.4.3",
    "lucide-react": "1.54.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@stoplight/spectral-core": "1.24.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-rulesets": "1.23.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "nanoid": "3.3.20",
    "postcss": "8.5.29"
  },
  "packageManager": "npm@12.2.0"
}
