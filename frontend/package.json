{
  "name": "astronomer-frontend",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prepare-static-assets.mjs",
    "build": "npm run type-check && vite build && node scripts/check-csp-build.mjs",
    "bundle:check": "node --test scripts/check-bundle-budget.test.mjs && node scripts/check-bundle-budget.mjs",
    "prebuild": "node scripts/prepare-static-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "node scripts/check-staged-formatting.mjs",
    "format:test": "node --test scripts/check-staged-formatting.test.mjs",
    "openapi:generate": "python3 ../scripts/categorical-contracts.py write && node ../scripts/generate-openapi-types.mjs --write && node ../scripts/generate-openapi-client.mjs --write",
    "openapi:check": "python3 ../scripts/categorical-contracts.py check-browser && node ../scripts/generate-openapi-types.mjs --check && node ../scripts/generate-openapi-client.mjs --check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser-components": "playwright test --config=playwright.components.config.ts",
    "test:e2e": "playwright test --config=playwright.live.config.ts",
    "pretest:e2e:visual": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium --project=tablet-chromium --project=mobile-chromium",
    "pretest:e2e:stubbed": "node scripts/generate-e2e-stubs.mjs",
    "test:e2e:stubbed": "playwright test --project=chromium --project=mobile-chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.14",
    "@wterm/core": "0.5.4",
    "@wterm/dom": "0.5.4",
    "@wterm/react": "0.5.4",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "js-yaml": "5.4.3",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "nanoid": "3.3.20",
    "postcss": "8.5.29"
  }
}
