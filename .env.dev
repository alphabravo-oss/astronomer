# Canonical local-development defaults (tracked). Per-developer overrides go in
# .env.dev.local (gitignored, auto-created by scripts/dev.sh). Ports are chosen
# not to collide with a local k3s (6443/10250), Vite (3000) or Grafana (3001).
# These secrets are LOCAL-DEV ONLY and are public in this repository; the
# server refuses them when ENV=production (internal/config/production.go).
DEV_PG_PORT=15432
DEV_REDIS_PORT=16379
DEV_WEB_PORT=3000
DEV_GRAFANA_PORT=3001
DEV_PROMETHEUS_PORT=9092
DEV_START_AGENT=0
DEV_USE_K3S=0

ENV=development
DEBUG=true
LOG_LEVEL=debug
SERVER_ADDR=:8000
SERVER_METRICS_ADDR=:9090
WORKER_METRICS_ADDR=:9091
DATABASE_URL=postgres://astronomer:astronomer@127.0.0.1:15432/astronomer?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0
SECRET_KEY=local-dev-jwt-signing-key-not-for-production-0001
ASTRONOMER_ENCRYPTION_KEY=RX3rwYkQNmaSq4_UmGs7sPXONIjnB-M6q0gZtB79vQA=
ASTRONOMER_INTERNAL_PSK=local-dev-internal-psk-not-for-production
ASTRONOMER_BOOTSTRAP_USERNAME=admin
ASTRONOMER_BOOTSTRAP_EMAIL=admin@astronomer.local
ASTRONOMER_BOOTSTRAP_PASSWORD=e2e-live-password
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*
AGENT_IMAGE_REPOSITORY=astronomer-go-agent
AGENT_IMAGE_TAG=dev
# OTLP gRPC to the compose Tempo (guide ch.05: localhost:4317, insecure in dev).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1
