{
  "title": "Astronomer — Management Plane",
  "uid": "astronomer-management-plane",
  "schemaVersion": 38,
  "version": 3,
  "tags": ["astronomer", "management-plane"],
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "metrics_namespace", "type": "constant", "label": "Metrics namespace", "query": "astronomer", "current": {"text": "astronomer", "value": "astronomer"}, "hide": 0}, {"name": "metrics_fullname", "type": "constant", "label": "Metrics service prefix", "query": "astronomer", "current": {"text": "astronomer", "value": "astronomer"}, "hide": 0}]},
  "panels": [
    {
      "title": "HTTP 5xx ratio (5m)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}},
      "targets": [{"expr": "astronomer:http_5xx_ratio:5m", "refId": "A"}]
    },
    {
      "title": "HTTP p99 latency (5m)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(astronomer_http_request_duration_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "title": "In-flight requests",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(astronomer_http_in_flight_requests)", "refId": "A"}]
    },
    {
      "title": "Agents disconnected",
      "description": "Counts only series from currently healthy server scrape targets. No data means no observed connection metrics; inspect scrape availability before interpreting this count.",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"noValue": "No data", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "targets": [{"expr": "sum((astronomer_agent_connections{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == bool 0) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1))", "refId": "A", "instant": true}]
    },
    {
      "title": "HTTP request rate by status class",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (status_class) (rate(astronomer_http_requests_total[5m]))", "legendFormat": "{{status_class}}", "refId": "A"}]
    },
    {
      "title": "HTTP latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(astronomer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(astronomer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(astronomer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "title": "Asynq queue depth by queue + state",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (queue, state) (astronomer_worker_queue_depth)", "legendFormat": "{{queue}}/{{state}}", "refId": "A"}]
    },
    {
      "title": "Asynq oldest-pending age by queue",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "max by (queue) (astronomer_worker_queue_latency_seconds)", "legendFormat": "{{queue}}", "refId": "A"}]
    },
    {
      "title": "Task outbox oldest-due age by status",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "max by (status) (astronomer_task_outbox_oldest_due_seconds)", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "title": "DB pool health (acquired / idle / max)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(astronomer_db_pool_acquired_connections)", "legendFormat": "acquired", "refId": "A"},
        {"expr": "sum(astronomer_db_pool_idle_connections)", "legendFormat": "idle", "refId": "B"},
        {"expr": "sum(astronomer_db_pool_max_connections)", "legendFormat": "max", "refId": "C"},
        {"expr": "sum(rate(astronomer_db_pool_empty_acquire_count_total[5m]))", "legendFormat": "empty-acquire/s", "refId": "D"}
      ]
    },
    {
      "title": "Transactional audit outbox age by status",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 300}]}}},
      "targets": [{"expr": "max by (status) (astronomer_audit_outbox_oldest_seconds)", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "title": "Transactional audit outbox rows by status",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0}},
      "targets": [{"expr": "sum by (status) (astronomer_audit_outbox_rows)", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "title": "Agent connections (0 = disconnected)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "targets": [{"expr": "astronomer_agent_connections", "legendFormat": "{{cluster_name}}", "refId": "A"}]
    },
    {
      "title": "Agent reconnect rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (cluster_id) (rate(astronomer_agent_reconnects_total[5m]))", "legendFormat": "{{cluster_id}}", "refId": "A"}]
    },
    {
      "title": "Management backup — hours since last success",
      "type": "stat",
      "gridPos": {"x": 0, "y": 44, "w": 8, "h": 4},
      "fieldConfig": {"defaults": {"unit": "h", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 26}]}}},
      "targets": [{"expr": "(time() - max(kube_job_status_completion_time{job_name=~\".*-management-backup-.*\"} and on(job_name) kube_job_status_succeeded{job_name=~\".*-management-backup-.*\"} > 0)) / 3600", "refId": "A"}]
    },
    {
      "title": "Restore drill — days since last success",
      "type": "stat",
      "gridPos": {"x": 8, "y": 44, "w": 8, "h": 4},
      "fieldConfig": {"defaults": {"unit": "d", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 14}]}}},
      "targets": [{"expr": "(time() - max(kube_job_status_completion_time{job_name=~\".*-restore-drill-.*\"} and on(job_name) kube_job_status_succeeded{job_name=~\".*-restore-drill-.*\"} > 0)) / 86400", "refId": "A"}]
    },
    {
      "title": "Backup / restore-drill failures (24h)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 44, "w": 8, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "targets": [{"expr": "sum(increase(kube_job_status_failed{job_name=~\".*-management-backup-.*|.*-restore-drill-.*\"}[24h]))", "refId": "A"}]
    },
    {
      "title": "Server scrape availability",
      "description": "1 means at least one replica is scraped successfully; 0 means all discovered replicas are down. No data means no target is discovered. This does not prove every replica is healthy.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Worker scrape availability",
      "description": "1 means at least one replica is scraped successfully; 0 means all discovered replicas are down. No data means no target is discovered. This does not prove every replica is healthy.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Process CPU usage (cores)",
      "description": "Per scraped server/worker replica. Missing or failed scrapes remain gaps; CPU rates require at least two samples.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m]) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "server {{pod}} / {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"}[5m]) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"} == 1)",
          "legendFormat": "worker {{pod}} / {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Go heap in use",
      "description": "Per scraped server/worker replica. Missing or failed scrapes remain gaps;",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 52,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "server {{pod}} / {{instance}}",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"} and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"} == 1)",
          "legendFormat": "worker {{pod}} / {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Go goroutines",
      "description": "Per scraped server/worker replica. Missing or failed scrapes remain gaps;",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 52,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "go_goroutines{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "server {{pod}} / {{instance}}",
          "refId": "A"
        },
        {
          "expr": "go_goroutines{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"} and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-worker-metrics\"} == 1)",
          "legendFormat": "worker {{pod}} / {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Embedded observation source availability",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. 1 means current sampled evidence; 0 means unavailable, partial or stale evidence. Standalone /metrics exists, but annotations do not establish downstream scraping or aggregation.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "astronomer_agent_delivery_observation_source_available{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}} / {{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embedded observation source age",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. Unknown age (-1) is omitted. Age is sampled source evidence, not scrape age.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "(astronomer_agent_delivery_observation_source_age_seconds{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} >= 0) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}} / {{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embedded tracked LIST/WATCH request rate",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. Actual tracked observation LIST/WATCH calls only, not all Kubernetes calls or watch lifecycle events.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace, service, instance, kind, verb, outcome) (rate(astronomer_agent_observation_requests_total{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m])) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}} / {{kind}} / {{verb}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embedded inventory refresh p95 duration",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. Discovery/dynamic refresh work excludes cache reads. No refresh samples remain no data.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (namespace, service, instance, source, outcome, le) (rate(astronomer_agent_delivery_observation_refresh_duration_seconds_bucket{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m]))) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}} / {{source}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embedded inventory refresh frequency",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. Discovery/dynamic refresh executions, not individual Kubernetes requests.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace, service, instance, source, outcome) (rate(astronomer_agent_delivery_observation_refresh_duration_seconds_count{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m])) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}} / {{source}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Server DB average acquisition duration",
      "description": "Embedded server targets only, per instance; missing or failed scrapes remain gaps. All pool acquisition time per acquisition, not exclusively blocked wait. Zero acquisition rate is omitted.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 76,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "(rate(astronomer_db_pool_acquire_duration_seconds_total{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m]) / (rate(astronomer_db_pool_acquire_count_total{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"}[5m]) > 0)) and on(namespace, service, instance) (up{namespace=\"${metrics_namespace}\",service=\"${metrics_fullname}-server-metrics\"} == 1)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
