{
  "title": "Astronomer — Continuous Delivery",
  "uid": "astronomer-continuous-delivery",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["astronomer", "continuous-delivery", "flux"],
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "title": "Active rollouts",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(astronomer_delivery_rollouts{state=~\"resolving|awaiting_approval|queued|progressing|paused|rolling_back\"}) or vector(0)", "refId": "A"}]
    },
    {
      "title": "Failed rollouts",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(astronomer_delivery_rollouts{state=~\"failed|rollback_failed\"}) or vector(0)", "refId": "A"}]
    },
    {
      "title": "Stale deployment status",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(astronomer_delivery_stale_deployments) or vector(0)", "refId": "A"}]
    },
    {
      "title": "Flux controllers not Ready",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(astronomer_delivery_flux_readiness{ready=\"false\"}) or vector(0)", "refId": "A"}]
    },
    {
      "title": "Rollouts by strategy and state",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (strategy,state) (astronomer_delivery_rollouts)", "legendFormat": "{{strategy}}/{{state}}", "refId": "A"}]
    },
    {
      "title": "Deployments by phase and drift",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (phase,drift) (astronomer_delivery_deployments)", "legendFormat": "{{phase}} drift={{drift}}", "refId": "A"}]
    },
    {
      "title": "Source resolution p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(astronomer_delivery_source_resolution_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(astronomer_delivery_source_resolution_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(astronomer_delivery_source_resolution_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "title": "Source resolution outcomes",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (source_type,result,verification) (rate(astronomer_delivery_source_resolutions_total[5m]))", "legendFormat": "{{source_type}}/{{result}}/{{verification}}", "refId": "A"}]
    },
    {
      "title": "Snapshot protocol outcomes",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (result) (rate(astronomer_delivery_assignment_snapshots_total[5m]))", "legendFormat": "{{result}}", "refId": "A"}]
    },
    {
      "title": "Worker outcomes",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (worker,result) (rate(astronomer_delivery_worker_events_total[5m]))", "legendFormat": "{{worker}}/{{result}}", "refId": "A"}]
    }
  ]
}
