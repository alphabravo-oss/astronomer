{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Astronomer Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "createNamespace": { "type": "boolean" },
    "namespace": { "type": "string", "minLength": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "mirrorMapping"],
      "properties": {
        "manifest": {"type": "string", "maxLength": 900000},
        "mirrorMapping": {"type": "string", "maxLength": 900000}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceURL", "digest", "mirrors", "allowPrivateMirrors", "proxy", "ca", "signature"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceURL": {
          "type": "string",
          "pattern": "^(https://[^?#]+|oci://[^?#]+@sha256:[0-9a-f]{64})$"
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mirrors": {
          "type": "object",
          "propertyNames": { "pattern": "^(https|oci)://[^?#]+$" },
          "additionalProperties": { "type": "string", "pattern": "^(https|oci)://[^?#]+$" }
        },
        "allowPrivateMirrors": { "type": "boolean" },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "urlSecretRef"],
          "properties": {
            "enabled": { "type": "boolean" },
            "urlSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        },
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "provider", "identity", "issuer", "keyRef", "trustKeys"],
          "properties": {
            "required": { "type": "boolean" },
            "provider": { "type": "string", "enum": ["cosign_key", "cosign_keyless"] },
            "identity": { "type": "string", "maxLength": 2048 },
            "issuer": { "type": "string", "maxLength": 2048 },
            "keyRef": { "type": "string", "maxLength": 253 },
            "trustKeys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["existingSecret"],
              "properties": { "existingSecret": { "type": "string" } }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "registry": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" },
        "allowSchemaSkew": { "type": "boolean" },
        "requireDigest": { "type": "boolean" },
        "server": { "$ref": "#/definitions/imageRef" },
        "worker": { "$ref": "#/definitions/imageRef" },
        "agent": { "$ref": "#/definitions/imageRef" },
        "migrate": { "$ref": "#/definitions/imageRef" }
      }
    },
    "frontend": { "$ref": "#/definitions/workload" },
    "server": { "$ref": "#/definitions/workload" },
    "worker": {
      "allOf": [{ "$ref": "#/definitions/workload" }],
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["", "bundled", "cloudNativePG", "external"] },
        "bundled": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxConnections": { "type": "integer", "minimum": 20, "maximum": 5000 }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dsn": { "type": "string" },
            "dsnSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        },
        "cloudNativePG": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "clusterName": { "type": "string" },
            "instances": { "type": "integer", "minimum": 1 },
            "imageName": { "type": "string", "minLength": 1 },
            "storage": { "type": "object", "additionalProperties": true },
            "walStorage": { "type": "object", "additionalProperties": true },
            "parameters": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "synchronousReplication": { "type": "object", "additionalProperties": true },
            "monitoring": { "type": "object", "additionalProperties": true },
            "barmanCloud": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "pluginName": { "type": "string", "minLength": 1 },
                "objectStoreName": { "type": "string" },
                "scheduledBackup": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "schedule": { "type": "string", "minLength": 1 },
                    "backupOwnerReference": { "type": "string", "enum": ["none", "self", "cluster"] }
                  }
                },
                "recovery": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "sourceName": { "type": "string", "minLength": 1 },
                    "objectStoreName": { "type": "string" },
                    "serverName": { "type": "string" },
                    "targetTime": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "passwordSecretRef": { "$ref": "#/definitions/secretKeyRef" },
        "productionRequirements": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "externalManagedOrHA": { "type": "boolean" },
            "tlsRequired": { "type": "boolean" },
            "pitrRequired": { "type": "boolean" },
            "logicalBackupsRequired": { "type": "boolean" },
            "restoreDrillRequired": { "type": "boolean" },
            "minimumDailyBackups": { "type": "integer", "minimum": 0 },
            "minimumWeeklyBackups": { "type": "integer", "minimum": 0 },
            "minimumMonthlyBackups": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["", "standalone", "sentinel", "external"] },
        "bundled": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "address": { "type": "string" },
            "tls": { "type": "boolean" },
            "database": { "type": "integer", "minimum": 0 },
            "urlSecretRef": { "$ref": "#/definitions/secretKeyRef" },
            "passwordSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        },
        "sentinel": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "replicas": { "type": "integer", "minimum": 3 },
            "sentinels": { "type": "integer", "minimum": 3 },
            "masterName": { "type": "string", "minLength": 1 },
            "quorum": { "type": "integer", "minimum": 2 },
            "downAfterMilliseconds": { "type": "integer", "minimum": 1000 },
            "failoverTimeoutMilliseconds": { "type": "integer", "minimum": 1000 },
            "parallelSyncs": { "type": "integer", "minimum": 1 },
            "passwordSecretRef": { "$ref": "#/definitions/secretKeyRef" },
            "podDisruptionBudget": { "type": "object", "additionalProperties": true },
            "topologySpread": { "type": "object", "additionalProperties": true }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "migrate": { "$ref": "#/definitions/workload" },
    "preflight": {
      "allOf": [{ "$ref": "#/definitions/workload" }],
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "databaseSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumUpgradeVersion": { "const": 1 },
            "targetVersion": { "const": 62 }
          },
          "required": ["minimumUpgradeVersion", "targetVersion"]
        }
      },
      "required": ["databaseSchema"]
    },
    "dex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "issuerURL": { "type": "string" },
        "runtimeSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*$"
        },
        "runtimeWriterServiceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" }
          },
          "required": ["name", "namespace"]
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": { "type": "string", "enum": ["fresh", "prepare", "cutover"] },
            "requirePreparedConfig": { "type": "boolean" }
          },
          "required": ["phase", "requirePreparedConfig"]
        },
        "image": { "$ref": "#/definitions/imageRef" },
        "podDisruptionBudget": { "type": "object", "additionalProperties": true },
        "affinity": { "type": "object", "additionalProperties": true },
        "topologySpread": { "type": "object", "additionalProperties": true },
        "resources": { "type": "object", "additionalProperties": true },
        "podSecurityContext": { "type": "object", "additionalProperties": true },
        "securityContext": { "type": "object", "additionalProperties": true }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env": { "type": "string", "enum": ["development", "test", "staging", "production"] },
        "debug": { "type": "string", "enum": ["true", "false"] },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "warning", "error"] },
        "serverURL": { "type": "string" },
        "jwtIssuer": { "type": "string", "minLength": 1 },
        "jwtAudience": { "type": "string", "minLength": 1 },
        "corsAllowedOrigins": { "type": "string" },
        "trustedProxyCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$" }, "uniqueItems": true },
        "apiK8sProxyRateLimitRPS": { "type": "number", "exclusiveMinimum": 0 },
        "apiK8sProxyRateLimitBurst": { "type": "integer", "minimum": 1 },
        "loginFailureThreshold": { "type": "integer", "minimum": 1 },
        "lockoutDurationMinutes": { "type": "integer", "minimum": 1 },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "localPasswordOnly": { "type": "boolean" },
            "totp": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "issuer": { "type": "string" },
                "require": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "localFluxBootstrap", "compatibility", "artifacts", "sourceResolution", "rollout", "status", "monitoring"],
      "properties": {
        "enabled": { "type": "boolean" },
        "localFluxBootstrap": { "type": "boolean" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kubernetes", "agentProtocol", "flux"],
          "properties": {
            "kubernetes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimumMinor", "maximumMinor"],
              "properties": {
                "minimumMinor": { "$ref": "#/definitions/kubernetesMinor" },
                "maximumMinor": { "$ref": "#/definitions/kubernetesMinor" }
              }
            },
            "agentProtocol": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimum", "maximum"],
              "properties": {
                "minimum": { "type": "integer", "minimum": 2 },
                "maximum": { "type": "integer", "minimum": 2 }
              }
            },
            "flux": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
              }
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicRegistry", "privateRegistry", "registryRewrites", "fluxDistribution", "builtInBundles"],
          "properties": {
            "publicRegistry": { "$ref": "#/definitions/registryHostOrEmpty" },
            "privateRegistry": { "$ref": "#/definitions/registryHostOrEmpty" },
            "registryRewrites": {
              "type": "object",
              "propertyNames": { "$ref": "#/definitions/registryHost" },
              "additionalProperties": { "$ref": "#/definitions/registryHost" }
            },
            "fluxDistribution": { "$ref": "#/definitions/signedArtifact" },
            "builtInBundles": { "$ref": "#/definitions/signedArtifact" }
          }
        },
        "sourceResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerConcurrency", "maxArtifactBytes", "maxHelmChartBytes", "egressCIDRs", "allowedPrivateHosts", "allowSSH", "proxy", "ca", "trustKeys"],
          "properties": {
            "workerConcurrency": { "type": "integer", "minimum": 1, "maximum": 256 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1048576, "maximum": 2147483648 },
            "maxHelmChartBytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
            "egressCIDRs": { "$ref": "#/definitions/stringArray" },
            "allowedPrivateHosts": { "$ref": "#/definitions/stringArray" },
            "allowSSH": { "type": "boolean" },
            "proxy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "urlSecretRef"],
              "properties": {
                "enabled": { "type": "boolean" },
                "urlSecretRef": { "$ref": "#/definitions/secretKeyRef" }
              },
              "allOf": [{
                "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                "then": {
                  "properties": {
                    "urlSecretRef": {
                      "required": ["name", "key"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "key": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }]
            },
            "ca": {
              "type": "object",
              "additionalProperties": false,
              "required": ["existingSecret", "key"],
              "properties": {
                "existingSecret": { "type": "string", "maxLength": 253 },
                "key": { "type": "string", "minLength": 1, "maxLength": 253 }
              }
            },
            "trustKeys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["existingSecret"],
              "properties": {
                "existingSecret": { "type": "string", "maxLength": 253 }
              }
            }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerConcurrency", "maxActiveRollouts", "maxClustersPerRollout", "maxConcurrentClustersGlobal", "defaultFailureBudget"],
          "properties": {
            "workerConcurrency": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "maxActiveRollouts": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxClustersPerRollout": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maxConcurrentClustersGlobal": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "defaultFailureBudget": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retentionDays", "historyPerDeployment", "coalesceWindowSeconds"],
          "properties": {
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "historyPerDeployment": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "coalesceWindowSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assignmentAckSecondsP99", "fluxTransitionVisibilitySecondsP99", "rolloutSchedulerSecondsP99", "staleClusterStatusSeconds"],
          "properties": {
            "assignmentAckSecondsP99": { "type": "integer", "minimum": 1 },
            "fluxTransitionVisibilitySecondsP99": { "type": "integer", "minimum": 1 },
            "rolloutSchedulerSecondsP99": { "type": "integer", "minimum": 1 },
            "staleClusterStatusSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKeyKey": { "type": "string", "minLength": 1 },
        "encryptionKeyKey": { "type": "string", "minLength": 1 },
        "internalPSKKey": { "type": "string", "minLength": 1 },
        "internalPSKPreviousKey": { "type": "string", "minLength": 1 },
        "postgresPasswordKey": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string" },
        "encryptionKey": { "type": "string" },
        "internalPSK": { "type": "string" },
        "internalPSKPrevious": { "type": "string" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "forcePasswordChange": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "enum": ["none", "selfSigned", "letsEncrypt", "secret", "externalGateway"] },
        "secretName": { "type": "string" },
        "requireCertManager": { "type": "boolean" },
        "letsEncrypt": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "email": { "type": "string" },
            "environment": { "type": "string", "enum": ["production", "staging"] }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "create": { "type": "boolean" },
        "className": { "type": "string" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "sectionName": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultDeny": { "type": "boolean" },
        "allowPublicIngress": { "type": "boolean" },
        "allowMetricsIngress": { "type": "boolean" },
        "externalEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "externalHTTPSEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "externalPostgresEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "externalRedisEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "kubernetesAPIEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "identityProviderEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "objectStoreEgressCIDRs": { "$ref": "#/definitions/stringArray" },
        "loggingSinkEgressCIDRs": { "$ref": "#/definitions/stringArray" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" }
          }
        }
      }
    },
    "managementBackup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "retention": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string", "minLength": 1 },
            "dryRun": { "type": "boolean" },
            "daily": { "type": "integer", "minimum": 1 },
            "weekly": { "type": "integer", "minimum": 1 },
            "monthly": { "type": "integer", "minimum": 1 },
            "credentialsSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "bucket": { "type": "string" },
            "credentialsSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        },
        "immutability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimumRetentionDays"],
          "properties": {
            "mode": { "type": "string", "enum": ["objectLock"] },
            "minimumRetentionDays": { "type": "integer", "minimum": 1, "maximum": 36500 }
          }
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceIdentity", "wrappingSecretRef"],
          "properties": {
            "sourceIdentity": { "type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]{0,252}$" },
            "wrappingSecretRef": { "$ref": "#/definitions/secretKeyRef" }
          }
        }
      }
    },
    "managementLogging": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "networkPolicyPorts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "managementRestoreDrill": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "env": { "const": "production" }
            },
            "required": ["env"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "properties": {
          "postgres": {
            "anyOf": [
              {
                "properties": {
                  "mode": { "const": "cloudNativePG" },
                  "cloudNativePG": {
                    "properties": { "instances": { "type": "integer", "minimum": 3 } },
                    "required": ["instances"]
                  }
                },
                "required": ["mode", "cloudNativePG"]
              },
              {
                "properties": {
                  "mode": { "const": "external" },
                  "external": {
                    "anyOf": [
                      { "required": ["dsn"], "properties": { "dsn": { "type": "string", "minLength": 1 } } },
                      { "required": ["dsnSecretRef"], "properties": { "dsnSecretRef": { "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } } } }
                    ]
                  }
                },
                "required": ["mode", "external"]
              }
            ]
          },
          "redis": {
            "anyOf": [
              {
                "properties": {
                  "mode": { "const": "sentinel" },
                  "sentinel": {
                    "properties": {
                      "replicas": { "type": "integer", "minimum": 3 },
                      "sentinels": { "type": "integer", "minimum": 3 },
                      "passwordSecretRef": {
                        "properties": { "name": { "type": "string", "minLength": 1 } },
                        "required": ["name"]
                      }
                    },
                    "required": ["replicas", "sentinels", "passwordSecretRef"]
                  }
                },
                "required": ["mode", "sentinel"]
              },
              {
                "properties": {
                  "mode": { "const": "external" },
                  "external": {
                    "anyOf": [
                      { "required": ["address"], "properties": { "address": { "type": "string", "minLength": 1 } } },
                      { "required": ["urlSecretRef"], "properties": { "urlSecretRef": { "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } } } }
                    ]
                  }
                },
                "required": ["mode", "external"]
              }
            ]
          },
          "config": {
            "properties": {
              "serverURL": { "type": "string", "pattern": "^https://" }
            },
            "required": ["serverURL"]
          },
          "gateway": {
            "properties": {
              "enabled": { "const": true },
              "hosts": { "type": "array", "minItems": 1 }
            },
            "required": ["enabled", "hosts"]
          },
          "tls": {
            "properties": {
              "source": { "enum": ["selfSigned", "letsEncrypt", "secret", "externalGateway"] }
            },
            "required": ["source"]
          },
          "secrets": {
            "properties": {
              "existingSecret": { "type": "string" },
              "secretKey": { "type": "string" },
              "encryptionKey": { "type": "string" },
              "internalPSK": { "type": "string" },
              "internalPSKPrevious": { "type": "string" }
            },
            "anyOf": [
              { "required": ["existingSecret"], "properties": { "existingSecret": { "type": "string", "minLength": 1 } } },
              {
                "required": ["secretKey", "encryptionKey"],
                "properties": {
                  "secretKey": { "type": "string", "minLength": 1, "not": { "const": "local-dev-secret-key-change-in-production" } },
                  "encryptionKey": { "type": "string", "minLength": 1, "not": { "const": "RX3rwYkQNmaSq4_UmGs7sPXONIjnB-M6q0gZtB79vQA=" } }
                }
              }
            ]
          },
          "bootstrap": {
            "properties": {
              "email": { "type": "string", "format": "email", "minLength": 1 }
            },
            "required": ["email"]
          },
          "managementBackup": {
            "if": {
              "properties": { "enabled": { "const": true } },
              "required": ["enabled"]
            },
            "then": {
              "properties": {
                "s3": {
                  "properties": {
                    "bucket": { "type": "string", "minLength": 1 },
                    "credentialsSecretRef": {
                      "required": ["name"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "required": ["bucket", "credentialsSecretRef"]
                },
                "immutability": {
                  "properties": {
                    "mode": { "const": "objectLock" },
                    "minimumRetentionDays": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["mode", "minimumRetentionDays"]
                },
                "encryption": {
                  "properties": {
                    "sourceIdentity": { "type": "string", "minLength": 1 },
                    "wrappingSecretRef": {
                      "required": ["name"],
                      "properties": { "name": { "type": "string", "minLength": 1 } }
                    }
                  },
                  "required": ["sourceIdentity", "wrappingSecretRef"]
                },
                "retention": {
                  "if": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  },
                  "then": {
                    "properties": {
                      "credentialsSecretRef": {
                        "required": ["name"],
                        "properties": { "name": { "type": "string", "minLength": 1 } }
                      }
                    },
                    "required": ["credentialsSecretRef"]
                  }
                }
              },
              "required": ["s3", "immutability", "encryption", "retention"]
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": { "const": true },
              "defaultDeny": { "const": true },
              "kubernetesAPIEgressCIDRs": { "$ref": "#/definitions/nonEmptyStringArray" }
            },
            "required": ["enabled", "defaultDeny", "kubernetesAPIEgressCIDRs"]
          },
          "image": {
            "properties": {
              "requireDigest": { "const": true }
            },
            "required": ["requireDigest"]
          },
          "preflight": {
            "properties": {
              "enabled": { "const": true },
              "databaseSchema": {
                "properties": {
                  "minimumUpgradeVersion": { "const": 1 },
                  "targetVersion": { "const": 62 }
                },
                "required": ["minimumUpgradeVersion", "targetVersion"]
              }
            },
            "required": ["enabled", "databaseSchema"]
          },
          "delivery": {
            "properties": {
              "enabled": { "const": true },
              "sourceResolution": {
                "properties": {
                  "egressCIDRs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "not": { "enum": ["0.0.0.0/0", "::/0"] }
                    }
                  }
                }
              },
              "artifacts": {
                "properties": {
                  "fluxDistribution": {
                    "properties": {
                      "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                      "trustPolicy": {
                        "properties": {
                          "requireSignature": { "const": true },
                          "certificateIdentity": { "type": "string", "minLength": 1 },
                          "oidcIssuer": { "type": "string", "pattern": "^https://", "minLength": 1 }
                        },
                        "required": ["requireSignature", "certificateIdentity", "oidcIssuer"]
                      }
                    },
                    "required": ["ociRepository", "digest", "trustPolicy"],
                    "anyOf": [
                      {
                        "properties": { "ociRepository": { "type": "string", "minLength": 1 } },
                        "required": ["ociRepository"]
                      },
                      {
                        "properties": { "disconnectedAssetPath": { "type": "string", "minLength": 1 } },
                        "required": ["disconnectedAssetPath"]
                      }
                    ]
                  },
                  "builtInBundles": {
                    "properties": {
                      "ociRepository": { "type": "string", "minLength": 1 },
                      "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                      "trustPolicy": {
                        "properties": {
                          "requireSignature": { "const": true },
                          "certificateIdentity": { "type": "string", "minLength": 1 },
                          "oidcIssuer": { "type": "string", "pattern": "^https://", "minLength": 1 }
                        },
                        "required": ["requireSignature", "certificateIdentity", "oidcIssuer"]
                      }
                    },
                    "required": ["ociRepository", "digest", "trustPolicy"]
                  }
                },
                "required": ["fluxDistribution", "builtInBundles"]
              }
            },
            "required": ["enabled", "sourceResolution", "artifacts"]
          }
        },
        "required": ["postgres", "redis", "gateway", "tls", "secrets", "bootstrap", "networkPolicy", "preflight", "delivery"]
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "env": { "const": "production" }
            },
            "required": ["env"]
          },
          "tls": {
            "properties": {
              "source": { "const": "letsEncrypt" }
            },
            "required": ["source"]
          }
        },
        "required": ["config", "tls"]
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "letsEncrypt": {
                "properties": {
                  "email": { "type": "string", "format": "email", "minLength": 1 }
                },
                "required": ["email"]
              }
            },
            "required": ["letsEncrypt"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "env": { "const": "production" }
            },
            "required": ["env"]
          },
          "tls": {
            "properties": {
              "source": { "const": "secret" }
            },
            "required": ["source"]
          }
        },
        "required": ["config", "tls"]
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "secretName": { "type": "string", "minLength": 1 }
            },
            "required": ["secretName"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "env": { "const": "production" }
            },
            "required": ["env"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "dex": {
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["dex"]
          },
          {
            "properties": {
              "config": {
                "properties": {
                  "auth": {
                    "properties": {
                      "localPasswordOnly": { "const": true }
                    },
                    "required": ["localPasswordOnly"]
                  }
                },
                "required": ["auth"]
              }
            },
            "required": ["config"]
          }
        ]
      }
    }
  ],
  "definitions": {
    "kubernetesMinor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "registryHost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?$"
    },
    "registryHostOrEmpty": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?$"
    },
    "signedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ociRepository", "digest", "disconnectedAssetPath", "trustPolicy"],
      "properties": {
        "ociRepository": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^(?:oci://)?[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
        },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "disconnectedAssetPath": { "type": "string", "maxLength": 1024, "pattern": "^$|^/[A-Za-z0-9._/-]+$" },
        "trustPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requireSignature", "certificateIdentity", "oidcIssuer"],
          "properties": {
            "requireSignature": { "const": true },
            "certificateIdentity": { "type": "string", "maxLength": 1024 },
            "oidcIssuer": { "type": "string", "maxLength": 1024, "pattern": "^https://" }
          }
        }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "registry": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "strategy": { "type": "object" },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        },
        "affinity": { "type": "object" },
        "topologySpread": { "type": "object" },
        "image": { "$ref": "#/definitions/imageRef" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "eventRelayQueueCapacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "env": { "type": "object" }
      }
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
