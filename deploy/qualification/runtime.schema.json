{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultPostgresMajor",
    "postgres",
    "valkey",
    "gotestsum",
    "requiredExtensions",
    "sourceEvidence",
    "limits",
    "kubernetes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultPostgresMajor": {
      "enum": [
        "17",
        "18"
      ]
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "17",
        "18"
      ],
      "properties": {
        "17": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "image",
            "lane"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(17|18)\\.[0-9]+$"
            },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
            },
            "lane": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "18": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "image",
            "lane"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(17|18)\\.[0-9]+$"
            },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
            },
            "lane": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "gotestsum": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requiredExtensions": {
      "const": [
        "citext",
        "pgcrypto",
        "uuid-ossp",
        "vector"
      ]
    },
    "sourceEvidence": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMinor",
        "lanes",
        "kubectlPolicy"
      ],
      "properties": {
        "defaultMinor": {
          "const": "1.36"
        },
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1.36",
            "1.37"
          ],
          "properties": {
            "1.36": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "image",
                "qualification"
              ],
              "properties": {
                "version": {
                  "const": "1.36.5+k3s1"
                },
                "image": {
                  "type": "string",
                  "pattern": "^rancher/k3s:v1\\.36\\.5-k3s1@sha256:[a-f0-9]{64}$"
                },
                "qualification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "1.37": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "image",
                "qualification"
              ],
              "properties": {
                "version": {
                  "const": "1.37.1+k3s1"
                },
                "image": {
                  "type": "string",
                  "pattern": "^rancher/k3s:v1\\.37\\.1-k3s1@sha256:[a-f0-9]{64}$"
                },
                "qualification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "kubectlPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
