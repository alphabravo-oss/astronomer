{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultPostgresMajor",
    "postgres",
    "valkey",
    "gotestsum",
    "requiredExtensions",
    "sourceEvidence",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultPostgresMajor": {
      "enum": [
        "17",
        "18"
      ]
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "17",
        "18"
      ],
      "properties": {
        "17": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "image",
            "lane"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(17|18)\\.[0-9]+$"
            },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
            },
            "lane": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "18": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "image",
            "lane"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(17|18)\\.[0-9]+$"
            },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
            },
            "lane": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "gotestsum": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requiredExtensions": {
      "const": [
        "citext",
        "pgcrypto",
        "uuid-ossp",
        "vector"
      ]
    },
    "sourceEvidence": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
