# syntax=docker/dockerfile:1.6
FROM docker.io/library/nginx:1.31.8-alpine3.24-slim@sha256:f45171d36c76a8b2f5ef97108a3a8a2294248a6578a0a180edc2d78f7d2edc26 AS nginx-base

# Keep the reverse-proxy image on the same patched, digest-pinned package set
# as the frontend image. The update is isolated before the final stage.
RUN apk update && apk upgrade && rm -rf /var/cache/apk/*

FROM nginx-base

# Drop the default site and ship our config.
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
