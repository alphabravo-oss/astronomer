{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "rule_id",
          "path",
          "line",
          "source_digest",
          "fingerprint",
          "release_scope",
          "reason",
          "owner",
          "approved_by",
          "evidence",
          "expires_at",
          "column"
        ],
        "properties": {
          "tool": {
            "enum": [
              "gosec",
              "govulncheck"
            ]
          },
          "rule_id": {
            "type": "string",
            "pattern": "^(G[0-9]{3}|GO-[0-9]{4}-[0-9]{4,})$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "release_scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
