{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "application-transfer-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "release",
    "catalog_digest",
    "archive_digest",
    "bom_digest",
    "publisher_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "application_catalog_transfer"
    },
    "release": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "archive_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bom_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publisher_mode": {
      "enum": [
        "production",
        "qa"
      ]
    }
  }
}
