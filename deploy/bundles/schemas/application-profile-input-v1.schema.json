{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "application-profile-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_digest",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application",
          "profile",
          "archive",
          "archive_digest",
          "values",
          "images",
          "kubernetes_version",
          "namespace"
        ],
        "properties": {
          "application": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "archive": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "archive_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "values": {
            "type": "object"
          },
          "images": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^@\\s]+/[^@\\s]+@sha256:[a-f0-9]{64}$",
              "maxLength": 2048
            }
          },
          "kubernetes_version": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        }
      }
    }
  }
}
