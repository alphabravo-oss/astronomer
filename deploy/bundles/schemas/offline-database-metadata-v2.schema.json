{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astronomer operator offline database metadata index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "repository",
    "digest",
    "catalog_digest",
    "profile",
    "subjects"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "const": "builtins"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "digest",
          "signature_digest"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
