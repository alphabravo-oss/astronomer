{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorityDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactDigests": {
            "items": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "selected": {
            "pattern": "^(?:v|go)?[0-9]+(?:\\.[0-9]+){1,2}(?:[+.-][0-9A-Za-z.-]+)?$",
            "type": [
              "string",
              "null"
            ]
          },
          "upstreamStable": {
            "pattern": "^(?:v|go)?[0-9]+(?:\\.[0-9]+){1,2}(?:[+.-][0-9A-Za-z.-]+)?$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "selected",
          "upstreamStable",
          "observedAt",
          "artifactDigests"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "expiresAt": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceCommit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "authorityDigest",
    "generatedAt",
    "expiresAt",
    "sourceCommit",
    "components"
  ],
  "type": "object"
}
