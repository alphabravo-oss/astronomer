{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.io/schemas/upgrade-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "namespace", "target_version", "mode", "result", "api_identity_sha256", "release_manifest_sha256", "backup_manifest_sha256", "database_restore_mode", "rollback_attempted", "completed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 63},
    "namespace": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 63},
    "target_version": {"type": "string", "pattern": "^v1\\.[0-9]+\\.[0-9]+$"},
    "mode": {"enum": ["dry_run", "upgrade"]},
    "result": {"enum": ["passed", "failed"]},
    "api_identity_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "backup_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "database_restore_mode": {"enum": ["verified_copy", "live_replaced"]},
    "rollback_attempted": {"type": "boolean"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
