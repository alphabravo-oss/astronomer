{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.io/schemas/runtime-image-evidence-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "release_version", "release_manifest_sha256", "result", "generated_at", "entries", "waivers_sha256", "license_policy_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "release_version": {"type": "string", "pattern": "^v1\\.[0-9]+\\.[0-9]+$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "result": {"const": "passed"},
    "generated_at": {"type": "string", "format": "date-time"},
    "waivers_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "license_policy_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "platforms", "sbom_sha256", "vulnerability_report_sha256", "high_critical_unwaived", "license_unwaived", "applied_waivers"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"},
        "platforms": {"const": ["linux/amd64", "linux/arm64"]},
        "sbom_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "vulnerability_report_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "high_critical_unwaived": {"const": 0}, "license_unwaived": {"const": 0},
        "applied_waivers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }}
  }
}
