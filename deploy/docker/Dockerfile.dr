# syntax=docker/dockerfile:1.7
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG VERSION=1.2.0
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apk add --no-cache \
      aws-cli \
      ca-certificates \
      postgresql16-client \
      py3-cryptography \
      python3

COPY deploy/dr/dr_crypto.py /usr/local/bin/dr-crypto
RUN chmod 0555 /usr/local/bin/dr-crypto

LABEL org.opencontainers.image.title="Astronomer management DR utility" \
      org.opencontainers.image.description="Authenticated PostgreSQL backup, restore, and retention runtime" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/alphabravo-oss/astronomer"

USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/dr-crypto"]
CMD ["--help"]
