# syntax=docker/dockerfile:1.7
# ── Build stage ───────────────────────────────────────────────────────────────
# GO_VERSION is derived from go.mod by the Makefile (make docker-build-astronomer-agent) and
# has no default on purpose: an image can never drift from go.mod (guide ch.04).
ARG GO_VERSION
# GO_IMAGE_DIGEST comes from deploy/docker/go-image.lock (no default: fail closed).
ARG GO_IMAGE_DIGEST
FROM golang:${GO_VERSION}-alpine@${GO_IMAGE_DIGEST} AS builder

RUN apk add --no-cache git

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -p 4 \
    -trimpath \
    -ldflags "-s -w \
      -X github.com/alphabravocompany/astronomer-go/pkg/version.Version=${VERSION} \
      -X github.com/alphabravocompany/astronomer-go/pkg/version.GitCommit=${GIT_COMMIT} \
      -X github.com/alphabravocompany/astronomer-go/pkg/version.BuildDate=${BUILD_DATE}" \
    -o /out/astronomer-agent ./cmd/agent

# ── Runtime stage ─────────────────────────────────────────────────────────────
# distroless static: CA bundle + tzdata + nonroot user, no shell, no package
# manager. Pinned by digest (guide ch.04).
FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/alphabravo-oss/astronomer" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --from=builder /out/astronomer-agent /usr/local/bin/astronomer-agent
# Health/metrics probe (HEALTH_PORT, default 8080).
EXPOSE 8080

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/astronomer-agent"]
