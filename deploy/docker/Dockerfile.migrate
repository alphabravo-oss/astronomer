# syntax=docker/dockerfile:1.6
# ── Migrate image ─────────────────────────────────────────────────────────────
# Build the repository-owned migration wrapper on the same Go toolchain as the
# other first-party images. It takes a database-scoped session lock before
# golang-migrate touches schema state, preventing concurrent installer
# deadlocks around non-transactional PostgreSQL DDL.
FROM golang:1.26.6-alpine@sha256:1a9c10cf505a9e6b1e96ea77ebdbfe79a0f10380181faf88bc3b51d7e4315fae AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/migrator ./cmd/migrator
ARG VERSION=1.2.0
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.buildVersion=${VERSION}" \
    -o /out/migrate ./cmd/migrator

FROM alpine:3.22@sha256:365499d9dccb7c8cfaffef995a6c382e71174585e0556f6476ead1c5971c39fb

ARG VERSION=1.2.0
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/alphabravo-oss/astronomer" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/migrate /usr/local/bin/migrate
COPY internal/db/migrations/*.sql /migrations/
RUN chmod 0755 /usr/local/bin/migrate && chmod 0644 /migrations/*.sql

USER nobody

ENTRYPOINT ["migrate"]
CMD ["-help"]
