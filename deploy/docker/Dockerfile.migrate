# syntax=docker/dockerfile:1.7
# Migrate image: the repository-owned migration runner (cmd/migrator) takes a
# database-scoped advisory lock before golang-migrate touches schema state.
# Scheduled for deletion in Phase 1 (goose embedded in the server binary).
ARG GO_VERSION
FROM golang:${GO_VERSION}-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/migrator ./cmd/migrator
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.buildVersion=${VERSION}" -o /out/migrate ./cmd/migrator

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/alphabravo-oss/astronomer" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --from=builder /out/migrate /usr/local/bin/migrate
COPY --chmod=0644 internal/db/migrations/*.sql /migrations/

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/migrate"]
CMD ["-help"]
